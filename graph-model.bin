–Ω–∞—à–ª—é–Ω–∞—à—É–º–µ–ª–∏–Ω–∞—à—ë–ø—Ç—ã–≤–∞–µ—Ç–Ω–∞—â–∏–Ω–∞—â—É–ø–∞–µ—à—å–Ω–∞—ç–¥–Ω–∞—è—Ä–∏–≤–∞–ª–Ω–≤–æ–Ω–≥–∞–Ω–∞—Å–∞–Ω—Å–∫–æ–º–Ω–≥–¥—É–Ω–≥–µ—Å—Å–æ–Ω–≥–∑–Ω–¥–µ—Ä—Å–æ–Ω–Ω–¥–∏–∏–Ω–¥–º—é—Ñ–¥—à–Ω–¥—Ä–æ–Ω–¥—Ö–º–Ω–≤–π—Å–Ω–µ–∞–∫—Ç–∏–≤–µ–Ω–Ω–µ–∞–∫—Ç–∏–≤–Ω–æ–º–Ω–µ–∞–º–µ—Ä–∏–∫–∞–Ω—Å–∫–∏–µ–Ω–µ–±–µ–∑–æ–ø–∞—Å–Ω–∞—è–Ω–µ–±–µ–∑–æ–ø–∞—Å–Ω–æ—Å—Ç–∏–Ω–µ–±–µ–∑—É—Å–ø–µ—à–Ω–æ–Ω–µ–±–µ—Å–µ–Ω–µ–±–∫–∞—É—Ä–∞–Ω–µ–±–ª–∞–≥–æ–¥–∞—Ä–µ–Ω –Ω–µ–±–ª–∞–≥–æ–ø—Ä–∏—è—Ç–Ω–æ–º—É–Ω–µ–±–ª–∞–≥–æ—Ä–æ–¥–Ω—ã—Ö–Ω–µ–±–æ–≥–∞—Ç–æ–º–Ω–µ–±–æ–ª—å—Å–∏–Ω–∞–Ω–µ–±—Ä–µ–∂–Ω—ã–º–∏–Ω–µ–±—Ä–æ–Ω–∏—Ä–æ–≤–∞–Ω–Ω—ã–µ–Ω–µ–±—Ä–æ—Å–∫–∞—è–Ω–µ–±—Ä–æ—Å–∫–∏–π–Ω–µ–±—ã–≤–∞–ª–æ–º–Ω–µ–≤–µ–¥–µ–Ω–∏–µ–º–Ω–µ–≤–µ–∂–µ—Å—Ç–≤–µ–Ω–Ω–æ–º—É–Ω–µ–≤–µ–∑–µ–Ω–∏–∏–Ω–µ–≤–µ—Ä–æ–º–Ω–µ–≤–µ—Ä—É—é—â–∞—è–Ω–µ–≤–µ—Å–µ–ª—ã–º–Ω–µ–≤–µ—Å–µ–ª—ã–º–∏–Ω–µ–≤–µ—Å—Ç–æ–∫–Ω–µ–≤–µ—Å—ë–ª–æ–µ–Ω–µ–≤–∑—Ä–∞—á–Ω—ã—Ö–Ω–µ–≤–º–µ–Ω—è–µ–º–∞—è–Ω–µ–≤–º–µ–Ω—è–µ–º—ã—Ö–Ω–µ–≤–æ–ª—å–Ω–∏–∫–∞–º –Ω–µ–≤–æ—Å—Ç—Ä–µ–±–æ–≤–∞–Ω–Ω—ã–π–Ω–µ–≤—Ä–æ–ª–æ–≥—É–Ω–µ–≤—ã–¥—É–º–∞–Ω–Ω—ã–µ–Ω–µ–≤—ã–ø–æ–ª–Ω–µ–Ω–Ω—ã–µ –Ω–µ–≤—ã—Ä–∞–∑–∏—Ç–µ–ª—å–Ω—ã–º–∏–Ω–µ–≤—å—è–Ω—Å–∫–æ–≥–æ–Ω–µ–≤—ë–Ω–µ–≥–∞—Ç–∏–≤–Ω—ã–Ω–µ–≥–ª—É–±–æ–∫–æ–º–Ω–µ–≥–æ–¥—É—é—â–∏–µ–Ω–µ–≥–æ–ª—É–±–æ–π–Ω–µ–≥–æ—Å—Ç–µ–ø—Ä–∏–∏–º–Ω–æ–Ω–µ–≥–æ—Ç–æ–≤—ã–º–∏–Ω–µ–≥—Ä–∏—Ç–µ–Ω–æ–∫–Ω–µ–≥—Ä–∏—Ç—ë–Ω–æ–∫–Ω–µ–≥—É–ª–µ—Å–∫–æ–Ω–µ–¥–∞–ª–µ–∫–∞—è–Ω–µ–¥–∞–ª–µ–∫–æ–π–Ω–µ–¥–∞–ª—å–Ω–æ–≤–∏–¥–Ω—ã–µ–Ω–µ–¥–≤—É—Å–º—ã—Å–ª–µ–Ω–Ω–æ–π–Ω–µ–¥–µ–ª–∏–º—ã—Ö"–Ω–µ–¥–µ–º–æ–∫—Ä–∞—Ç–∏—á–µ—Å–∫–∏–º–Ω–µ–¥–µ—è–Ω–∏–µ–Ω–µ–¥–µ—è–Ω–∏—è
–Ω–µ–¥–∑–µ(–Ω–µ–¥–∏—Å—Ü–∏–ø–ª–∏–Ω–∏—Ä–æ–≤–∞–Ω–Ω—ã–π–Ω–µ–¥–∏—á–∞$–Ω–µ–¥–æ–±—Ä–æ–∂–µ–ª–∞—Ç–µ–ª—å–Ω—ã–º"–Ω–µ–¥–æ–±—Ä–æ–∂–µ–ª–∞—Ç–µ–ª—è–º–∏–Ω–µ–¥–æ–≤–µ—Ä—á–∏–≤–∞—è–Ω–µ–¥–æ–≤–µ—Å–Ω–µ–¥–æ–≥–ª—è–¥–µ–ª–Ω–µ–¥–æ–¥–∞–ª–∏–Ω–µ–¥–æ–∫–æ—Ä–º–Ω–µ–¥–æ–ª—ë—Ç–Ω–µ–¥–æ–º–æ–≥–∞–Ω–∏–π–Ω–µ–¥–æ–Ω–æ—Å–∫–æ–≤–Ω–µ–¥–æ–æ—Ü–µ–Ω–µ–Ω–Ω–µ–¥–æ–æ—Ü–µ–Ω–∫—É–Ω–µ–¥–æ—Ä–æ—Å–ª–∏–Ω–µ–¥–æ—Å–∫–∞–∑–∞–Ω–Ω—ã–º–Ω–µ–¥–æ—Å—Ç–æ–≤–µ—Ä–Ω—ã–Ω–µ–¥–æ—Å—Ç—Ä–æ–µ–Ω–Ω–æ–µ–Ω–µ–¥–æ—Å—Ç—Ä–æ–µ–Ω–Ω–æ–º–Ω–µ–¥–æ—Å—á–∏—Ç–∞–ª—Å—è–Ω–µ–¥–æ—Ç—ë–ø–Ω–µ–¥–æ—É–º–µ–Ω–Ω–æ–µ–Ω–µ–¥–æ—É—á–∫–æ–π–Ω–µ–¥—ã–Ω–µ–µ–≤–∫–ª–∏–¥–æ–≤–æ–π–Ω–µ–µ–≤—Ä–µ–π—Å–∫–∏—Ö–Ω–µ–µ–µ–µ–µ—Ç–Ω–µ–∂–¥–∞–Ω–∞–Ω–µ–∂–µ–Ω–∞—Ç—ã–º–Ω–µ–∂–∏–∑–Ω–µ—Å–ø–æ—Å–æ–±–Ω—ã–Ω–µ–∂–∏–ª–∞—è–Ω–µ–∂–Ω–µ–π—à–∏—Ö–Ω–µ–∂–Ω–æ—Å—Ç—è–º–∏–Ω–µ–∑–∞–±—ã–≤–∞–µ–º–æ–º–Ω–µ–∑–∞–±—ã–≤–∞–µ–º—ã–Ω–µ–∑–∞–±—ã–≤–∞–µ–º—ã–º–∏–Ω–µ–∑–∞–≤–µ—Ä—à–µ–Ω–Ω–æ–≥–æ–Ω–µ–∑–∞–≤–µ—Ä—à–µ–Ω–Ω–æ—Å—Ç—å–Ω–µ–∑–∞–≤–µ—Ä—à–µ–Ω–Ω—ã–π–Ω–µ–∑–∞–≤–µ—Ä—à–µ–Ω–Ω—ã–º–∏–Ω–µ–∑–∞–≤–µ—Ä—à—ë–Ω–Ω–æ—Å—Ç–∏–Ω–µ–∑–∞–∂–∏–≤–∞—é—â–µ–π&–Ω–µ–∑–∞–∫–æ–Ω–Ω–æ—Ä–æ–∂–¥–µ–Ω–Ω–æ–≥–æ–Ω–µ–∑–∞–∫—Ä—ã—Ç—É—é–Ω–µ–∑–∞–ª–µ–∂–Ω—É—é–Ω–µ–∑–∞–ª–µ–∂–Ω—ã–º–Ω–µ–∑–∞–º–µ—Ç–Ω–µ–π(–Ω–µ–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä–æ–≤–∞–Ω–Ω–∞—è(–Ω–µ–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä–æ–≤–∞–Ω–Ω—ã–π–Ω–µ–∑–∞—Å–ª—É–∂–µ–Ω–Ω—ã—Ö–Ω–µ–∑–∞—â–∏—â—ë–Ω–Ω—ã–º–∏–Ω–µ–∑–≤–∞–Ω–∞—è–Ω–µ–∑–¥–µ—à–Ω–∏–µ–Ω–µ–∑–µ–º–Ω—ã–º–∏–Ω–µ–∑–Ω–∞–Ω—å—é–Ω–µ–∑—Ä–∏–º–æ–º–Ω–µ–∑—Ä–∏–º—ã–º–∏–Ω–µ–∑—ã–±–ª–µ–º–æ–≥–æ–Ω–µ–∑—ã–±–ª–µ–º—ã–Ω–µ–∏–∑–≤–µ–¥–∞–Ω–Ω–æ—Å—Ç—å–Ω–µ–∏–∑–º–µ–Ω—è–µ–º—ã–µ–Ω–µ–∏–∑—É—á–µ–Ω–Ω–æ–π–Ω–µ–∏–º—É—â–∏–µ–Ω–µ–∏—Å–∫—Ä–µ–Ω–Ω–∏–º"–Ω–µ–∏—Å–ø–æ–ª—å–∑–æ–≤–∞–Ω–Ω–æ–≥–æ–Ω–µ–∏—Å–ø—Ä–∞–≤–∏–º–æ–π–Ω–µ–∏—Å–ø—Ä–∞–≤–Ω—ã–º–∏–Ω–µ–∏—Å—Ç–æ–≤—É—é–Ω–µ–∏—Å—á–µ—Ä–ø–∞–µ–º–∞–Ω–µ–π–∑–±–∏–Ω–µ–π—Ä–∞—Ç&–Ω–µ–π—Ä–æ–¥–µ–≥–µ–Ω–µ—Ä–∞—Ç–∏–≤–Ω—ã—Ö–Ω–µ–π—Ä–æ–Ω–∞—É–∫–∏–Ω–µ–π—Ä–æ–ø—Å–∏—Ö–æ–ª–æ–≥–∏—è–Ω–µ–π—Ä–æ—Ç–æ–∫—Å–∏–Ω–∞–Ω–µ–π—Ç—Ä–∞–ª–∏–∑—É–µ–º–Ω–µ–π—Ç—Ä–∞–ª–∏—Ç–µ—Ç–æ–º–Ω–µ–∫–∞–∑–∏—Å—Ç—ã–µ–Ω–µ–∫–∞—Ä–∏–æ–∑–Ω—ã—Ö–Ω–µ–∫–∞—á–µ—Å—Ç–≤–µ–Ω–Ω–∞—è–Ω–µ–∫–æ–Ω–¥–∏—Ü–∏–æ–Ω–Ω–æ–π*–Ω–µ–∫–æ–Ω–∫—É—Ä–µ–Ω—Ç–æ—Å–ø–æ—Å–æ–±–Ω–æ–π–Ω–µ–∫–æ—Ä—Ä–µ–∫—Ç–Ω–∞—è–Ω