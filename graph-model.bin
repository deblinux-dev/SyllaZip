–Ω–µ–∑–∞–º—É—Ç–Ω—ë–Ω–Ω—ã–º –Ω–µ–∑–∞–º—ã—Å–ª–æ–≤–∞—Ç–æ—Å—Ç–∏ –Ω–µ–∑–∞–º—ã—Å–ª–æ–≤–∞—Ç–æ—Å—Ç—å–Ω–µ–∑–∞–Ω–∏–º–∞—Ç–µ–ª—å–Ω–∞—è–Ω–µ–∑–∞–Ω—è—Ç—ã–π–Ω–µ–∑–∞–ø–∞–¥–Ω—ã–π–Ω–µ–∑–∞–ø–∞–º—è—Ç–Ω–æ–π–Ω–µ–∑–∞–ø–µ—Ä—Ç—ã–µ–Ω–µ–∑–∞–ø–µ—Ä—Ç—ã—Ö–Ω–µ–∑–∞–ø–∏—Å–∞–Ω–Ω–æ–µ$–Ω–µ–∑–∞–ø–ª–∞–Ω–∏—Ä–æ–≤–∞–Ω–Ω–æ–º—É–Ω–µ–∑–∞–ø–Ω–æ–Ω–µ–∑–∞–ø–æ–ª–Ω–µ–Ω–Ω–∞—è–Ω–µ–∑–∞–ø–æ–ª–Ω–µ–Ω–Ω—ã–π–Ω–µ–∑–∞–ø—Ä–æ—à–µ–Ω–Ω—ã—Ö–Ω–µ–∑–∞–ø—è—Ç–Ω–∞–Ω–Ω–æ–µ–Ω–µ–∑–∞—Ä–∞–±–æ—Ç–∞–Ω–Ω—ã—Ö–Ω–µ–∑–∞—Ä–∞–∑–Ω–æ–Ω–µ–∑–∞—Ä–∞–∑–Ω–æ–µ–Ω–µ–∑–∞—Ä–∞–∑–Ω—ã–µ–Ω–µ–∑–∞—Ä–∞–∑–Ω—ã–º–Ω–µ–∑–∞—Ä–∞–∑–Ω—ã–º–∏–Ω–µ–∑–∞—Ä–∞–∑–Ω—ã—Ö–Ω–µ–∑–∞—Ä–∞—â–µ–Ω–∏—è(–Ω–µ–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä–æ–≤–∞–Ω–Ω–æ–µ(–Ω–µ–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä–æ–≤–∞–Ω–Ω–æ–º–Ω–µ–∑–∞—Ä—è–∂–µ–Ω–Ω–æ–π–Ω–µ–∑–∞—Å–µ–ª—ë–Ω–Ω—É—é–Ω–µ–∑–∞—Å–ª—É–∂–µ–Ω–Ω–∞–Ω–µ–∑–∞—Å–ª—É–∂–µ–Ω–Ω–∞—è–Ω–µ–∑–∞—Å–ª—É–∂–µ–Ω–Ω–æ–≥–æ–Ω–µ–∑–∞—Å–ª—É–∂–µ–Ω–Ω—ã–º–∏–Ω–µ–∑–∞—Å—Ç—Ä–æ–µ–Ω–Ω–æ–µ–Ω–µ–∑–∞—Å—Ç—Ä–æ–µ–Ω–Ω—ã—Ö–Ω–µ–∑–∞—Ç–µ–π–ª–∏–≤–æ–≥–æ–Ω–µ–∑–∞—Ç–æ–ø–ª–µ–Ω–Ω—ã—Ö–Ω–µ–∑–∞—Ç—É—Ö–∞—é—â–∏–µ–Ω–µ–∑–∞—É—Ä—è–¥–µ–Ω–Ω–µ–∑–∞—Ö–æ–¥—è—â–µ–≥–æ–Ω–µ–∑–∞—à–∏—Ñ—Ä–æ–≤–∞–Ω–Ω—ã—Ö–Ω–µ–∑–∞—â–∏—â–µ–Ω–Ω–æ–≥–æ–Ω–µ–∑–∞—â–∏—â—ë–Ω–Ω–æ–µ–Ω–µ–∑–∞—â–∏—â—ë–Ω–Ω–æ–º—É–Ω–µ–∑–∞—â–∏—â—ë–Ω–Ω–æ—Å—Ç–∏–Ω–µ–∑–∞—â–∏—â—ë–Ω–Ω—ã–º–∏–Ω–µ–∑–∞—è–≤–ª–µ–Ω–Ω–∞—è–Ω–µ–∑–≤–∞–ª–Ω–µ–∑–≤–∞–Ω–Ω–æ–≥–æ–Ω–µ–∑–≤–∞–Ω–æ–Ω–µ–∑–≤–∞–Ω—É—é–Ω–µ–∑–≤–∏—á–∞–π–Ω–π–Ω–µ–∑–≤—ã—á–∞–π–Ω—ã–Ω–µ–∑–¥–µ—à–Ω–µ–≥–æ–Ω–µ–∑–¥–µ—à–Ω–∏—Ö–Ω–µ–∑–¥–µ—à–Ω—é—é–Ω–µ–∑–¥–æ–ª—ã–Ω–µ–∑–¥–æ—Ä–æ–≤–æ–º—É–Ω–µ–∑–µ–º–Ω–æ–º–Ω–µ–∑–µ–º–Ω–æ—é–Ω–µ–∑–µ—Ä–∏—Ç–∏—Å"–Ω–µ–∑–µ—Ä–∫–∞–ª–∏—Ä–æ–≤–∞–Ω–Ω–æ–º–Ω–µ–∑–ª–æ–±–∏–≤–æ–≥–æ–Ω–µ–∑–ª–æ–±–∏–≤–æ–µ–Ω–µ–∑–ª–æ–±–∏–≤—ã–º–Ω–µ–∑–ª–æ–±–Ω–æ–Ω–µ–∑–ª–æ–π–Ω–µ–∑–ª—ã–µ–Ω–µ–∑–Ω–∞–µ–º–Ω–µ–∑–Ω–∞–µ—à—å–Ω–µ–∑–Ω–∞–π–∫—É–Ω–µ–∑–Ω–∞–º–æ–≤—É–Ω–µ–∑–Ω–∞–Ω—å—è–Ω–µ–∑–Ω–∞—Ç–Ω–æ–µ–Ω–µ–∑–Ω–∞—Ç–Ω—ã–º–Ω–µ–∑–Ω–∞—á–∞—â–∏–µ–Ω–µ–∑–Ω–∞—á–∞—â–∏—Ö–Ω–µ–∑–Ω–∞—á–∏–º–æ–π–Ω–µ–∑–Ω–∞—á–∏–º–æ—Å—Ç—å–Ω–µ–∑–Ω–∞—á–∏–º—ã–µ–Ω–µ–∑–Ω–∞—á–∏–º—ã–º–Ω–µ–∑–Ω–∞—é—â–∏–π–Ω–µ–∑–Ω–∞—ë–º—É—é–Ω–µ–∑–Ω–∞—ë–º—ã–Ω–µ–∑—Ä–∞–∑—É–º–µ–ª–∞–Ω–µ–∑—Ä–≤–Ω—è–Ω–Ω–∞–Ω–µ–∑—Ä–µ–ª–æ–º–Ω–µ–∑—Ä–µ–ª—É—é–Ω–µ–∑—