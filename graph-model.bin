–∑–∞–º–æ–≤–∑–∞–º–æ–ª–≤–∏—Ç–∑–∞–º–æ–ª–∫–∞–ª–∞–∑–∞–º–æ—Ä–∞–∂–∏–≤–∞–Ω–∏—é–∑–∞–º–æ—Ä–æ—á–µ–∫–∑–∞–º–æ—Ä–æ—á–∏—Ç—å–∑–∞–º–æ—Å–∫–≤–æ—Ä–µ—Ü–∫–∞—è–∑–∞–º–æ—Å–∫–≤–æ—Ä–µ—Ü–∫–∏–π–∑–∞–º–æ—Å—Ç–∏–ª–∏–∑–∞–º–æ—Å—Ç—å–µ–∑–∞–º–æ—á—É–∑–∞–º—É–∑–∞–º—É—Ä–ª—ã–∫–∞–ª–∑–∞–º—É—Ä–ª—ã–∫–∞–ª–∞–∑–∞–º—É—Ä–æ–≤–∞–Ω–Ω—ã–µ–∑–∞–º—É—Ç–∏–ª–∞–∑–∞–º—É—á–∞—é—Ç–∑–∞–º—É—á–µ–Ω—ã–∑–∞–º—ã–∑–≥–∞–Ω–Ω–æ–º–∑–∞–º—ã—á–∞–ª–∞–∑–∞–º—è—Ç–∏–Ω—Å–∫–∏–π–∑–∞–º—ë—Ä–∑–ª–æ–∑–∞–º—ë—Ä–∑—à–µ–≥–æ–∑–∞–º—ë—Ä–∑—à–∏—Ö–∑–∞–Ω–∞–∑–∞–Ω–µ—Ä–≤–Ω–∏—á–∞—Ç—å–∑–∞–Ω–µ—Å–µ–Ω–∏–µ–º–∑–∞–Ω–µ—Å–µ–Ω–∏—è–∑–∞–Ω–µ—Å–µ—Ç–∑–∞–Ω–∏–∂–µ–Ω–Ω–æ–≥–æ–∑–∞–Ω–∏–º–∞–≤—à–∏–º—Å—è–∑–∞–Ω–∏–º–∞—é—â–µ–º
–∑–∞–Ω–æ—Å–∑–∞–Ω—è–≤—à–∏–π—Å—è–∑–∞–æ–∫–µ–∞–Ω—Å–∫–∏—Ö–∑–∞–æ–Ω–µ–∂—å–µ–∑–∞–æ—Å—Ç—Ä–µ–Ω–Ω—ã–µ–∑–∞–æ—Å—Ç—Ä–µ–Ω–Ω—ã–º–∑–∞–æ—Å—Ç—Ä—è–µ—Ç–∑–∞–æ—Ö–∞–ª–∞$–∑–∞–ø–∞–¥–Ω–æ–≥–µ—Ä–º–∞–Ω—Å–∫–æ–≥–æ–∑–∞–ø–∞–∑–¥—ã–≤–∞–Ω–∏–µ–∑–∞–ø–∞–ª–æ–∑–∞–ø–∞—Å–∞—Ç—å–∑–∞–ø–∞—Å–Ω–æ–µ–∑–∞–ø–∞—Å–Ω—ã–π–∑–∞–ø–∞—Ö–∞—Ö–∑–∞–ø–∞—Ö–Ω—É–ª–∑–∞–ø–∞—Ö–Ω—É–ª–∞–∑–∞–ø–∞—á–∫–∞–Ω–Ω–æ–π–∑–∞–ø–∞—á–∫–∞–Ω—ã–∑–∞–ø–µ—á–∞—Ç–∞–Ω–∞–∑–∞–ø–µ—á–∞—Ç–ª–µ–≤–∞—Ç—å–∑–∞–ø–µ—á–∞—Ç–ª–µ–ª–æ—Å—å–∑–∞–ø–µ—á—å–∑–∞–ø–∏–≤–∞–ª–∑–∞–ø–∏–≤–∞—é—Ç–∑–∞–ø–∏—Å–æ—á–∫–∞–∑–∞–ø–ª–∞—Ç–∞–∑–∞–ø–ª–µ—Å—Ç–∏–∑–∞–ø–ª–µ—Ç–∞–µ—Ç—Å—è–∑–∞–ø–ª–µ—Ç–∞–ª–∏—Å—å–∑–∞–ø–ª–µ—Ç–∞—Ç—å–∑–∞–ø–ª—ã–≤–∞–µ—Ç–∑–∞–ø–ª—ã—Ç—å–∑–∞–ø–æ–≤–µ–¥–∞–Ω–æ–∑–∞–ø–æ–≤–µ–¥—É—é–∑–∞–ø–æ–≤–µ–¥—å—é–∑–∞–ø–æ–¥–æ–∑—Ä–µ–Ω–∑–∞–ø–æ–∑–¥–∞–ª—ã–º–∏–∑–∞–ø–æ–ª–∑–ª–∏–∑–∞–ø–æ–ª–Ω–∏–º–∑–∞–ø–æ–ª–Ω—è–ª–∞—Å—å–∑–∞–ø–æ–ª–Ω—è—é–∑–∞–ø–æ–ª–Ω—è—é—â–µ–π–∑–∞–ø–æ–ª–æ–Ω–∏—Ç—å–∑–∞–ø–æ–ª–æ—à–Ω—ã–π–∑–∞–ø–æ–º–∏–Ω–∞–µ—à—å–∑–∞–ø–æ–º–∏–Ω–∞—é—â–µ–π—Å—è–∑–∞–ø–æ—Ä–æ–∂—Å–∫–∏–º–∑–∞–ø–æ—Ä–æ–∂—Å–∫–∏–º–∏–∑–∞–ø–æ—Ä–æ–∑—å–∫–æ–≥–æ–∑–∞–ø–æ—Ä—é
–∑–∞–ø–æ—é–∑–∞–ø—Ä–∞–≤–ª–µ–Ω–Ω—ã–π–∑–∞–ø—Ä–∞–≤—â–∏–∫–æ–º–∑–∞–ø—Ä–µ–¥–µ–ª—å–Ω—É—é–∑–∞–ø—Ä–µ—Ç–∏–∑–∞–ø—Ä–µ—Ç–∏—Ç–µ–ª—å–Ω—ã—Ö–∑–∞–ø—Ä–µ—Ç–Ω–æ–º—É–∑–∞–ø—Ä–µ—â–∞–≤—à–µ–≥–æ–∑–∞–ø—Ä–µ—â—ë–Ω–Ω—É—é–∑–∞–ø—Ä–æ—à–µ–Ω–Ω–∞—è–∑–∞–ø—Ä—É–¥—É–∑–∞–ø—Ä—É—Å—å–∑–∞–ø—Ä—è–≥–∏–∑–∞–ø—Ä—è—Ç–∞–ª–∏–∑–∞–ø—Ä—è—Ç–∞–Ω–Ω—ã–π–∑–∞–ø—É–∑–∞–ø—É–≥–∞–Ω–Ω—ã–µ–∑–∞–ø—É–≥–∞–Ω–Ω—ã–º–∏–∑–∞–ø—É–≥–∞–Ω–Ω—ã—Ö–∑–∞–ø—É—Å–∫–∞–µ–º–æ–≥–æ–∑–∞–ø—É—Å–∫–∞–µ–º–æ–µ–∑–∞–ø—É—Å–∫–∞–µ–º—ã–π–∑–∞–ø—É—Ç–∞–µ—à—å—Å—è–∑–∞–ø—É—Ç—ã–≤–∞—é—Ç–∑–∞–ø—É—Ç—ã–≤–∞—é—Ç—Å—è–∑–∞–ø—É—Ç—ã–≤–∞—è–∑–∞–ø—ã–ª–µ–Ω–Ω–∞—è–∑–∞–ø—ã—Ö–∞–≤—à–∞—è—Å—è–∑–∞—Ä–∞–±–∞—Ç—ã–≤–∞—é—Ç—Å—è–∑–∞—Ä–∞–±–æ—Ç–∫—É–∑–∞—Ä–∞–∂–∞–µ—Ç—Å—è–∑–∞—Ä–∞–∂–∞—é—Ç–∑–∞—Ä–∞–∂–µ–Ω–∏–µ–º–∑–∞—Ä–∞–∂–µ–Ω–Ω—É—é–∑–∞—Ä–∞–∂—ë–Ω–Ω–æ—Å—Ç–∏–∑–∞—Ä–∞–∑–∏—Ç–µ–ª—å–Ω–æ–π–∑–∞—Ä–∞–∑–Ω—ã–º–∑–∞—Ä–∞–∑–æ–π–∑–∞—Ä–∞—Å—Ç–∞–Ω–∏–µ–∑–∞—Ä–∞—Å—Ç–µ—Ç–∑–∞—Ä–µ–≥—É–ª–∏—Ä–æ–≤–∞–Ω
