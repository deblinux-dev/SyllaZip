–∑–∞–µ—Å—Ç–∑–∞–∂–∞—Ç–∏—è–∑–∞–∂–∞—Ç—ã—Ö–∑–∞–∂–∂–µ–Ω–Ω—ã–µ–∑–∞–∂–∂–µ–Ω—ã–∑–∞–∂–∏–≤–ª–µ–Ω–∏—é–∑–∞–∂–∏–≥–∞–µ–º–∑–∞–∂–∏–≥–∞–µ—à—å–∑–∞–∂–∏–≥–∞–ª–∫–∞—Ö–∑–∞–∂—Ä–∞–ª–∏—Å—å–∑–∞–∂—Ä–∞–ª—Å—è–∑–∞–∑–≤–µ–Ω—è—Ç–∑–∞–∑–≤–æ–Ω—è—Ç–∑–∞–∑–≤—ã—á–∞–π–∑–∞–∑–µ–º–ª–µ–Ω–∏–µ–∑–∞–∑–Ω–∞–≤–∞—Ç—å—Å—è–∑–∞–∑–Ω–∞–µ—Ç—Å—è–∑–∞–∑–Ω–∞–π–∫—É–∑–∞–∑—ã–≤–Ω–æ–∑–∞–∏–≥—Ä–∞–ª–æ–∑–∞–∏–≥—Ä–∞—é—Ç–∑–∞–∏–∫–∞–µ—à—å—Å—è–∑–∞–∏–∫–∞–ª–∞—Å—å–∑–∞–∏–º–∫–∏–∑–∞–∏–º—Å—Ç–≤–æ–≤–∞–ª–æ$–∑–∞–∏–Ω—Ç–µ—Ä–µ—Å–æ–≤–∞–≤—à–∏–π—Å—è–∑–∞–∏–Ω—Ç—Ä–∏–≥–æ–≤–∞–Ω–Ω—ã–µ–∑–∞–∏—Å–∫–∏–≤–∞–Ω–∏–µ–∑–∞–π–¥–∑–∞–π–¥–º–∞–Ω–∑–∞–π–¥–º–∞–Ω–∞–∑–∞–π–∫–æ–≤–∞–∑–∞–π–ª–∏—Å–∑–∞–π–º–∞—Ç–∏—Å—è–∑–∞–π—Å–∞–Ω–∑–∞–π—Ü–µ–≤—É–∑–∞–π—á–∏–∫–æ–≤–∞–∑–∞–π—á–∏—à–∫—É–∑–∞–∫–∞–¥—ã—á–Ω—ã–º–∑–∞–∫–∞–¥—ã—á–Ω—ã–º–∏–∑–∞–∫–∞–∑—á–∏–∫–∞—Ö–∑–∞–∫–∞–ª–µ–Ω–Ω—ã–π–∑–∞–∫–∞–ª–∏—Ç—å–∑–∞–∫–∞–ª—è—Ç—å–∑–∞–∫–∞–Ω—á–∏–≤–∞—é—â–∞—è—Å—è –∑–∞–∫–∞–Ω—á–∏–≤–∞—é—â–∏–º–∏—Å—è–∑–∞–∫–∞—Ç–∞–π—Ç–µ–∑–∞–∫–∞—Ç–Ω—ã—Ö–∑–∞–∫–∞—Ç—ã–≤–∞–ª–∏–∑–∞–∫–∞—á–∏–≤–∞—Ç—å–∑–∞–∫–∞—á—É–∑–∞–∫–∏–¥—ã–≤–∞—é—Ç–∑–∞–∫–∏–Ω—å–∑–∞–∫–∏–ø–∞–ª–∏–∑–∞–∫–∏–ø–µ–ª–æ–∑–∞–∫–ª–∞–¥—ã–≤–∞–ª–æ–∑–∞–∫–ª–µ–π–º–µ–Ω–Ω—ã–π–∑–∞–∫–ª–∏–Ω–∞–Ω–∏—è–º–∑–∞–∫–ª—é—á–∞–≤—à–µ–π—Å—è–∑–∞–∫–ª—é—á–∞—é—â–∏—Ö—Å—è–∑–∞–∫–æ–≤–∞–Ω–Ω–∞—è–∑–∞–∫–æ–≤–∞–Ω–Ω—ã–π–∑–∞–∫–æ–¥–∏—Ä–æ–≤–∞–Ω–Ω—ã–µ–∑–∞–∫–æ–¥–∏—Ä–æ–≤–∞–Ω–Ω—ã–π–∑–∞–∫–æ–¥–∏—Ä–æ–≤–∞–Ω–æ–∑–∞–∫–æ–ª–∞—á–∏–≤–∞—é—Ç–∑–∞–∫–æ–ª–æ–ª–∞–∑–∞–∫–æ–ª–æ—Ç–∏–ª–∑–∞–∫–æ–ª–æ—á–µ–Ω–Ω—ã–º–∏–∑–∞–∫–æ–Ω–æ–º–µ—Ä–µ–Ω–∑–∞–∫–æ–Ω–æ–º–µ—Ä–Ω–∞–∑–∞–∫–æ–Ω–æ–º–µ—Ä–Ω—É—é"–∑–∞–∫–æ–Ω–æ–ø–æ—Å–ª—É—à–Ω–æ—Å—Ç–∏–∑–∞–∫–æ–Ω–æ–ø—Ä–æ–µ–∫—Ç–∞–º$–∑–∞–∫–æ–Ω—Å–µ—Ä–≤–∏—Ä–æ–≤–∞–Ω–Ω—ã—Ö–∑–∞–∫–æ–Ω—á–∏–≤—à–∏—Ö–∑–∞–∫–æ–ø–∞—Ç—å—Å—è–∑–∞–∫–æ—Å—Ç–µ–Ω–µ–ª–æ–π–∑–∞–∫—Ä–∞—à–µ–Ω–∞–∑–∞–∫—Ä–µ–ø–ª–µ–Ω–Ω–∞—è–∑–∞–∫—Ä–µ–ø–ª—é–∑–∞–∫—Ä–µ–ø–ª—è—é—â–µ–π–∑–∞–∫—Ä–µ–ø–ª—è—é—â–∏–π–∑–∞–∫—Ä–µ–ø–æ—â–µ–Ω–∏—è–∑–∞–∫—Ä—É–≥–ª—è—é—Å—å–∑–∞–∫—Ä—É–∂–∏—Ç–∑–∞–∫—Ä—É—Ç–∏–≤–∑–∞–∫—Ä—É—Ç–∏–ª–∏–∑–∞–∫—Ä—É—Ç–∏—Ç–∑–∞–∫—Ä—É—á–µ–Ω–Ω—ã–º–∏–∑–∞–∫—Ä—É—á–∏–≤–∞–µ—Ç–∑–∞–∫—Ä—É—á–∏–≤–∞–ª–∏—Å—å–∑–∞–∫—Ä—É—á–∏–≤–∞—è—Å—å–∑–∞–∫—Ä—ã–≤–∞—é—â–µ–≥–æ–∑–∞–∫—Ä—ã–≤–∞—é—â–∏–º–∏–∑–∞–∫—Ä—