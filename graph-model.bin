–Ω–∞—Ü–∏—Ä–Ω–∞—Ü–∏—Å—Ç–∫–æ–π–Ω–∞—Ü–∏—Å—Ç—Å–∫–æ–º—É–Ω–∞—Ü—É–Ω–æ–Ω–∞—á–∞–≤—à–µ–º—É—Å—è–Ω–∞—á–µ—Ä—Ç–∞–Ω–Ω—ã–π–Ω–∞—á–∏–Ω–∞—é—â–∏–º–∏—Å—è–Ω–∞—á–∏–Ω–∏—Ç—å–Ω–∞—á–∏—Å—Ç–∏—Ç—å–Ω–∞—á–∏—Ç–∞–≤—à–∏—Å—å–Ω–∞—à–µ–¥—à–∏–º–Ω–∞—à–∏–¥–∞–Ω–∞—â–æ–Ω–∞—â—É–ø—ã–≤–∞—Ç—å
–Ω–∞—è–¥—ã–Ω–µ–∞–∫—Ç–∏–≤–Ω—ã–Ω–µ–∞–ª–ª–µ–ª—å–Ω—ã—Ö–Ω–µ–∞–ø–æ–ª–∏—Ç–∞–Ω—Ü—ã–Ω–µ–±–Ω–µ–±–ª–∞–≥–æ–ø–æ–ª—É—á–∏–µ–Ω–µ–±–æ–≥–∞—Ç–æ–≥–æ–Ω–µ–±–æ—Å–∫–ª–æ–Ω–∞–Ω–µ–±—Ä–µ–∂–Ω–æ–π–Ω–µ–±—Ä–µ–∂–Ω–æ—Å—Ç—å—é–Ω–µ–±—Ä–∏—Ç—ã–µ–Ω–µ–±—Ä–∏—Ç—ã–º–Ω–µ–≤–∞–∂–Ω–∞—è–Ω–µ–≤–µ–¥–µ–Ω–∏–µ–º–Ω–µ–≤–µ–∂–µ–π–Ω–µ–≤–µ–∂–µ—Å—Ç–≤–µ–Ω–Ω–æ–≥–æ–Ω–µ–≤–µ–∑—É—á–∏–π–Ω–µ–≤–µ—Ä–æ—è—Ç–Ω–æ—Å—Ç–∏–Ω–µ–≤–µ—Å–æ–º—É—é–Ω–µ–≤–µ—Å–æ–º—ã–º–∏–Ω–µ–≤–µ—Å—ë–ª—ã–µ–Ω–µ–≤–∏–¥–∞–Ω–Ω–æ–Ω–µ–≤–∏–Ω–Ω–æ–º—ã—Å—Å–∫–Ω–µ–≤–º–µ–Ω—è–µ–º–æ—Å—Ç—å–Ω–µ–≤–º–æ—á—å–Ω–µ–≤–æ–ª—å–Ω—ã–º–∏–Ω–µ–≤–æ–ª—å–Ω—ã—Ö–Ω–µ–≤–æ—Å–ø—Ä–∏–∏–º—á–∏–≤—ã–Ω–µ–≤—Ä–∞—Å—Ç–µ–Ω–∏–∫–Ω–µ–≤—Å–∫–∏–µ–Ω–µ–≤—Å–∫–∏—Ö–Ω–µ–≤—ã–≥–æ–¥–Ω–æ–≥–æ–Ω–µ–≤—ã–ø–æ–ª–Ω–∏–º—ã–º–Ω–µ–≤—ã–ø—É–∫–ª—ã–π–Ω–µ–≤—ã—Ä–∞–∑–∏—Ç–µ–ª—å–Ω—ã–º–Ω–µ–≥–ª—É–ø—ã–π–Ω–µ–≥–æ–¥–Ω–∏–∫–∞–Ω–µ–≥–æ–¥—É—é—Ç$–Ω–µ–≥–æ—Å—É–¥–∞—Ä—Å—Ç–≤–µ–Ω–Ω–æ–≥–æ–Ω–µ–≥—Ä–∞–º–æ—Ç–Ω–æ–≥–æ–Ω–µ–≥—Ä–∞–ø–æ–Ω—Ç–æ–≤–Ω–µ–≥—É—Å—Ç–æ–Ω–µ–¥–∞–ª–µ–∫–∏–º–Ω–µ–¥–≤–∏–∂–∏–º–æ–π–Ω–µ–¥–µ–µ—Å–ø–æ—Å–æ–±–Ω—ã–µ–Ω–µ–¥–µ–π—Å—Ç–≤–∏—Ç–µ–ª—å–Ω—ã–Ω–µ–¥–µ–ª–∏–º—ã–π–Ω–µ–¥–µ–ª–∏–º—ã–º"–Ω–µ–¥–µ–º–æ–∫—Ä–∞—Ç–∏—á–µ—Å–∫–∏–º–Ω–µ–¥–æ–Ω–µ–¥–æ–±—Ä–∞—è–Ω–µ–¥–æ–±—Ä–æ–≥–æ–Ω–µ–¥–æ–±—Ä—ã–º–∏–Ω–µ–¥–æ–≤–µ—Ä–∏—é–Ω–µ–¥–æ–≤–æ–ª—å–Ω—É—é–Ω–µ–¥–æ–∑–≤–æ–ª–µ–Ω–Ω–æ–µ–Ω–µ–¥–æ–∫–∞–∑–∞–Ω–Ω–æ–π–Ω–µ–¥–æ–ª–≥–æ–º
–Ω–µ–¥–æ–º–Ω–µ–¥–æ–æ—Ü–µ–Ω–∏–ª–∞–Ω–µ–¥–æ—Ä–∞–∑–≤–∏—Ç—ã–π–Ω–µ–¥–æ—Å–∫–∞–∑–∞–Ω–Ω–æ–µ–Ω–µ–¥–æ—Å—Ç–∏–∂–∏–º–Ω–µ–¥–æ—Å—Ç–æ–≤–µ—Ä–Ω—ã—Ö–Ω–µ–¥–æ—Å—Ç–æ–π–Ω–æ–º—É–Ω–µ–¥–æ—Å—Ç—Ä–æ–µ–Ω–Ω–æ–≥–æ–Ω–µ–¥–æ—Å—Ç—Ä–æ–µ–Ω–Ω–æ–º–Ω–µ–¥–æ—Å—Ç—É–ø–Ω–æ–≥–æ–Ω–µ–¥–æ—Å—ã–ø–∞–Ω–µ–¥–æ—Å—è–≥–∞–µ–º–æ—Å—Ç–∏–Ω–µ–¥–æ—Å—è–≥–∞–µ–º—É—é–Ω–µ–¥–æ—É–º–µ–Ω–Ω—ã–µ–Ω–µ–¥–æ—É–º–µ–Ω–Ω—ã–π–Ω–µ–¥–æ—É–º–∫–æ–≤–Ω–µ–¥–æ—á–µ–ª–æ–≤–µ–∫–∞–º–∏–Ω–µ–¥—Ä—É–≥–∞–º–Ω–µ–¥—É–Ω–µ–µ–≤—Ä–µ–π—Å–∫–∏—Ö–Ω–µ–µ–≤—Ä–µ–π—Å–∫–æ–≥–æ–Ω–µ–µ–≤—Ä–µ—è–Ω–µ–µ—Å—Ç–µ—Å—Ç–≤–µ–Ω–Ω—ã—Ö–Ω–µ–∂–µ–Ω–∞—Ç—ã—Ö –Ω–µ–∂–∏–∑–Ω–µ—Å–ø–æ—Å–æ–±–Ω—ã—Ö–Ω–µ–∑–∞–±—ã–≤–∞–µ–º–æ–º–Ω–µ–∑–∞–≤–µ—Ä—à—ë–Ω–Ω–æ–µ–Ω–µ–∑–∞–≤–µ—Ä—à—ë–Ω–Ω—ã–π–Ω–µ–∑–∞–ª–µ–∂–Ω—É—é–Ω–µ–∑–∞–º–µ–Ω–∏–º–∞–Ω–µ–∑–∞–º–µ–Ω–∏–º—É—é–Ω–µ–∑–∞–º–µ—Ç–Ω—É—é–Ω–µ–∑–∞–ø–∞–¥–Ω—ã—Ö"–Ω–µ–∑–∞–ø–ª–∞–Ω–∏—Ä–æ–≤–∞–Ω–Ω—ã–π–Ω–µ–∑–∞–ø—è—Ç–Ω–∞–Ω–Ω–æ–π–Ω–µ–∑–∞—Ç–µ–π–ª–∏–≤–æ–π–Ω–µ–∑–∞—Ç–µ–π–ª–∏–≤—ã–π–Ω–µ–∑–∞—É—Ä—è–¥–Ω–æ–π–Ω–µ–∑–∞—â–∏—â–µ–Ω–Ω–æ—Å—Ç—å–Ω–µ–∑–¥–µ—à–Ω–∏–π–Ω–µ–∑–¥–æ—Ä–æ–≤—É—é–Ω–µ–∑–¥–æ—Ä–æ–≤—ã–º–∏–Ω–µ–∑—Ä–µ–ª–æ—Å—Ç–∏–Ω–µ–∑—Ä–∏–º—ã–º–Ω–µ–∑—Ä—è—á–∏–π–Ω–µ–∑—ã–±–ª–µ–º–æ–≥–æ–Ω–µ–∑—ã–±–ª–µ–º—ã–π–Ω–µ–∏–∑–≤–µ–¥–∞–Ω–Ω–∞—è–Ω–µ–∏–∑–≤–µ–¥–∞–Ω–Ω–æ–π–Ω–µ–∏–∑–¥–∞–Ω–Ω—ã–µ–Ω–µ–∏–∑–ª–µ—á–∏–º–∞–Ω–µ–∏–∑–º–µ–Ω—è–µ–º–æ–π–Ω–µ–∏–º–æ–≤–µ—Ä–Ω—É—é–Ω–µ–∏–º–æ–≤–µ—Ä–Ω—ã–π–Ω–µ–∏–º—É—â–µ–≥–æ–Ω–µ–∏–Ω—Ç–µ—Ä–µ—Å–Ω–∞—è–Ω–µ–∏–Ω—Ç–µ—Ä–µ—Å–Ω—ã–º–Ω–µ–∏–Ω—Ç–µ—Ä–µ—Å–Ω—ã–º–∏–Ω–µ–∏—Å–∫—Ä–µ–Ω–Ω–µ–Ω–µ–∏—Å–ø—Ä–∞–≤–∏–º–∞–Ω–µ–∏—Å–ø—Ä–∞–≤–∏–º–∞—è–Ω–µ–∏—Å–ø—Ä–∞–≤–Ω–∞–Ω–µ–∏—Å–ø—Ä–∞–≤–Ω—ã–Ω–µ–∏—Å—Å–ª–µ–¥–æ–≤–∞–Ω–Ω—ã–µ–Ω–µ–∏—Å—Å—è–∫–∞–µ–º–æ–≥–æ–Ω–µ–∏—Å—á–∏—Å–ª–∏–º—ã—Ö–Ω–µ–π–∫–Ω–µ–π–º–∞–Ω–æ–º–Ω–µ–π—Ä–æ–≥–ª–∏–∏–Ω–µ–π—Ä–æ–ª–µ–ø—Ç–∏–∫–∞"–Ω–µ–π—Ä–æ–ª–µ–ø—Ç–∏—á–µ—Å–∫–æ–≥–æ–Ω–µ–π—Ç—Ä–∞–ª—å–Ω–∞–Ω–µ–π—Ç—Ä–æ–Ω–Ω–æ–Ω–µ–∫–∞–Ω–æ–Ω–∏—á–µ—Å–∫–æ–π–Ω–µ–∫–∞—á–µ—Å—Ç–≤–µ–Ω–Ω–æ–Ω–µ–∫–∞—á–µ—Å—Ç–≤–µ–Ω–Ω—ã—Ö–Ω–µ–∫–≤–∞–Ω—Ç–æ–≤–æ–π,–Ω–µ–∫–æ–Ω–∫—É—Ä–µ–Ω—Ç–æ—Å–ø–æ—Å–æ–±–Ω—ã–º–∏"–Ω–µ–∫–æ–Ω—Ç—Ä–æ–ª–∏—Ä—É–µ–º—ã–º–∏–Ω–µ–∫—Ä–æ–ª–æ–≥–æ–≤–Ω–µ–∫—É—Ä—è—â–∏–µ–Ω–µ–ª–∏–±–µ—Ä–∞–ª—å–Ω—ã—Ö–Ω–µ–ª–∏–Ω–µ–π–Ω–æ–µ–Ω–µ–ª–∏–Ω–µ–π–Ω–æ—Å—Ç—å–Ω–µ–ª–∏–Ω–µ–π–Ω—ã–π–Ω–µ–ª–∏—á–Ω—ã–µ–Ω–µ–ª—å—Å–æ–Ω—É–Ω–µ–ª—ë–≥–∫—É—é–Ω–µ–º–∞—Ç–æ–¥—ã
–Ω–µ–º–∫—É–Ω–µ–º–æ–≥—É–Ω–µ–º–æ–ª–æ–¥—ã–µ–Ω–µ–º–æ—â–Ω–æ–π–Ω–µ–º–æ—â—å—é–Ω–µ–º—Ä–Ω–µ–º—ã–Ω–µ–º—ã—Å–ª–∏–º–æ–º–Ω–µ–º—ã—Å–ª–∏–º—É—é–Ω–µ–º—ã—Å–ª–∏–º—ã–π –Ω–µ–Ω–∞–≤–∏—Å—Ç–Ω–∏—á–µ—Å–∫–∏–µ–Ω–µ–Ω–∞–∑–≤–∞–Ω–Ω–æ–≥–æ–Ω–µ–Ω–∞–∑–≤–∞–Ω–Ω—ã—Ö –Ω–µ–Ω–∞—Å–∏–ª—å—Å—Ç–≤–µ–Ω–Ω—ã–º–Ω–µ–Ω–∞—É—á–Ω–æ–µ–Ω–µ–æ–±–¥—É–º–∞–Ω–Ω—ã–π–Ω–µ–æ–±–¥—É–º–∞–Ω–Ω—ã–º–Ω–µ–æ–±—Ä–∞–±–æ—Ç–∞–Ω–Ω–æ–π–Ω–µ–æ–±—Ä–∞–∑–æ–≤–∞–Ω–Ω—ã–º–Ω–µ–æ–±—Ä–∞—Ç–∏–º–∞–Ω–µ–æ–±—Ä–∞—Ç–∏–º–æ—Å—Ç—å–Ω–µ–æ–±—ä—è–≤–ª–µ–Ω–Ω–æ–π–Ω–µ–æ–±—ä—è—Ç–Ω–æ–º–Ω–µ–æ–±—ä—è—Ç–Ω—É—é–Ω–µ–æ–±—ä—è—Ç–Ω—ã–º–Ω–µ–æ–±—ã—á–∞–π–Ω—ã–º–Ω–µ–æ–±—è–∑–∞—Ç–µ–ª—å–Ω–æ–≥–æ–Ω–µ–æ–≥–µ–Ω–æ–≤–æ–≥–æ–Ω–µ–æ–¥–Ω–æ–∑–Ω–∞—á–Ω—ã–Ω–µ–æ–¥–Ω–æ—Ä–æ–¥–Ω–∞ –Ω–µ–æ–∫–æ–Ω—Å–µ—Ä–≤–∞—Ç–∏–∑–º–∞–Ω–µ–æ–∫–æ–Ω—á–µ–Ω–Ω—ã–µ–Ω–µ–æ–∫–æ–Ω—á–µ–Ω–Ω—ã–π–Ω–µ–æ–ª–∏–±–µ—Ä–∞–ª—å–Ω–æ–≥–æ–Ω–µ–æ–ª–∏–±–µ—Ä–∞–ª—å–Ω—ã–µ–Ω–µ–æ–ª–∏–±–µ—Ä–∞–ª—å–Ω—ã–º–∏–Ω–µ–æ–ª–æ–≥–∏–∑–º—ã–Ω–µ–æ–Ω–∞—Ü–∏—Å—Ç—Å–∫–∏–µ–Ω–µ–æ–ø–∞—Å–Ω–æ–Ω–µ–æ–ø–∏—Å—É–µ–º—ã—Ö–Ω–µ–æ–ø–æ–∑–Ω–∞–Ω–Ω—ã–º–Ω–µ–æ–ø—Ä–∞–≤–¥–∞–Ω–Ω–æ–≥–æ–Ω–µ–æ–ø—Ä–∞–≤–¥–∞–Ω–Ω–æ–µ–Ω–µ–æ–ø—Ä–µ–¥–µ–ª—ë–Ω–Ω—É—é"–Ω–µ–æ—Å–≤–µ–¥–æ–º–ª–µ–Ω–Ω–æ—Å—Ç—å–Ω–µ–æ—Å–ø–æ—Ä–∏–º–∞—è–Ω–µ–æ—Å—É—â–µ—Å—Ç–≤–∏–º—ã–µ–Ω–µ–æ—Ç–≤—Ä–∞—Ç–∏–º–æ–≥–æ–Ω–µ–æ—Ç–¥–µ–ª–∏–º–æ–Ω–µ–æ—Ç–ª–∏—á–∏–º–æ–Ω–µ–æ—Ç—Ä–∏—Ü–∞—Ç–µ–ª—å–Ω–∞–Ω–µ–æ—Ç—Ä–∏—Ü–∞—Ç–µ–ª—å–Ω—ã–µ–Ω–µ–æ—Ü–µ–Ω–∏–º–æ–µ–Ω–µ–æ—Ü–µ–Ω–∏–º–æ–π–Ω–µ–æ—è–∑—ã—á–µ—Å–∫–∏–π–Ω–µ–ø–∞–∑–±–µ–∂–Ω–∞(–Ω–µ–ø–ª–∞—Ç–µ–∂–µ—Å–ø–æ—Å–æ–±–Ω–æ—Å—Ç—å$–Ω–µ–ø–ª–∞—Ç–µ–∂–µ—Å–ø–æ—Å–æ–±–Ω—ã–µ–Ω–µ–ø–æ–±–µ–¥–∏–º–∞–Ω–µ–ø–æ–≤–∏–Ω–æ–≤–µ–Ω–∏–µ–º–Ω–µ–ø–æ–≤—Ç–æ—Ä–∏–º–Ω–µ–ø–æ–≤—Ç–æ—Ä–∏–º—ã—Ö–Ω–µ–ø–æ–≥–æ–¥–æ–π–Ω–µ–ø–æ–¥–≤–ª–∞—Å—Ç–Ω—ã"–Ω–µ–ø–æ–¥–≥–æ—Ç–æ–≤–ª–µ–Ω–Ω—ã–º–∏ –Ω–µ–ø–æ–¥—Ç–≤–µ—Ä–∂–¥–µ–Ω–Ω—ã–º–Ω–µ–ø–æ–¥—Ö–æ–¥—è—â–∞—è–Ω–µ–ø–æ–¥—ä—ë–º–Ω—ã–µ –Ω–µ–ø–æ–∑–≤–æ–ª–∏—Ç–µ–ª—å–Ω–∞—è –Ω–µ–ø–æ–∑–≤–æ–ª–∏—Ç–µ–ª—å–Ω–æ–π–Ω–µ–ø–æ–∫–æ—Ä–Ω—ã–º–Ω–µ–ø–æ–ª–Ω–æ—Ü–µ–Ω–Ω—ã–π–Ω–µ–ø–æ–ª—è—Ä–Ω—ã–µ–Ω–µ–ø–æ—Ä–æ—á–Ω–æ–Ω–µ–ø–æ—Ä–æ—á–Ω–æ—Å—Ç—å–Ω–µ–ø–æ—Å–≤—è—â–µ–Ω–Ω—ã—Ö–Ω–µ–ø–æ—Å–µ–¥–æ–π–Ω–µ–ø–æ—Å–∏–ª—å–Ω—ã–º–∏–Ω–µ–ø–æ—Å–ª—É—à–Ω–æ–≥–æ–Ω–µ–ø–æ—Å–ª—É—à–Ω–æ–π–Ω–µ–ø–æ—Å–ª—É—à–Ω—É—é–Ω–µ–ø–æ—