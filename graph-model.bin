–∑–∞–ø—Å—ã–∑–∞–ø—É–≥–∞—é—Ç–∑–∞–ø—É–≥–∏–≤–∞–µ—Ç–µ–∑–∞–ø—É–≥–∏–≤–∞–µ—à—å–∑–∞–ø—É–≥–∏–≤–∞–π–∑–∞–ø—É–ª—å—Å–∏—Ä–æ–≤–∞–ª–∏–∑–∞–ø—É—Å–∫–∞–µ–º–∞—è–∑–∞–ø—É—Å–∫–∞–ª–æ—Å—å–∑–∞–ø—É—Å–∫–∞—é—â–µ–≥–æ–∑–∞–ø—É—Å–∫–∞—é—â–∏–π–∑–∞–ø—É—Å–∫–∞—é—â—É—é–∑–∞–ø—É—Å—Ç–µ–Ω–∏–µ–º–∑–∞–ø—É—Å—Ç–∏–ª–∏—Å—å–∑–∞–ø—É—Å—Ç–∏—à—å–∑–∞–ø—É—Ç–∞–≤—à–∞—è—Å—è–∑–∞–ø—É—Ç–∞–≤—à–∏–µ—Å—è–∑–∞–ø—É—Ç–∞–≤—à–∏—Ö—Å—è–∑–∞–ø—É—Ç–∞–Ω–Ω–∞–∑–∞–ø—É—Ç–∞—é—Å—å–∑–∞–ø—É—Ç–∞—é—Ç—Å—è–∑–∞–ø—É—Ç—ã–≤–∞–ª–∑–∞–ø—É—Ç—ã–≤–∞–ª–∏—Å—å–∑–∞–ø—É—â–µ–Ω–Ω–æ—Å—Ç—å–∑–∞–ø—É—â–µ–Ω–Ω–æ—Å—Ç—å—é–∑–∞–ø—ã–ª–∞–ª–∞–∑–∞–ø—ã–ª–µ–Ω–Ω–æ–≥–æ–∑–∞–ø—ã–ª–µ–Ω–Ω—ã–π–∑–∞–ø—ã—Ç–∞–ª–∏–∑–∞–ø—ã—Ö–∞—Ç—å—Å—è–∑–∞–ø—ã—Ö—Ç–µ–ª–∞–∑–∞–ø—è—Å—Ç—å—è–º–∑–∞–ø—è—Ç–Ω–∞–≤—à–∏–π–∑–∞–ø—è—Ç–Ω–∞–Ω–Ω–∞—è–∑–∞–ø—è—Ç–Ω–∞–Ω–Ω—ã–π–∑–∞–ø—è—Ç–Ω–∞–Ω–Ω—ã–º–∑–∞–ø—ë–∫—à–∞—è—Å—è–∑–∞–ø—ë–∫—à–∏–µ—Å—è–∑–∞—Ä–∞–±–∞—Ç—ã–≤–∞–π—Ç–µ–∑–∞—Ä–∞–±–∞—Ç—ã–≤–∞—é—â–∏–π–∑–∞—Ä–∞–±–æ—Ç–∞–≤—à–∏–π–∑–∞—Ä–∞–±–æ—Ç–∞–ª–∏—Å—å–∑–∞—Ä–∞–±–æ—Ç–∞–Ω–æ–∑–∞—Ä–∞–∂–∞–µ—à—å—Å—è–∑–∞—Ä–∞–∂–∞–ª–∞–∑–∞—Ä–∞–∂–∞—Ç—å—Å—è–∑–∞—Ä–∞–∂–∞—é—â–∏–µ–∑–∞—Ä–∞–∂–µ–Ω–Ω–∞—è–∑–∞—Ä–∞–∑–∏–≤—à–∏–µ—Å—è–∑–∞—Ä–∞–∑–∏–ª–æ—Å—å–∑–∞—Ä–∞–∑–∏–º–∑–∞—Ä–∞–∑–∏—Ç–µ–ª—å–Ω–∞—è–∑–∞—Ä–∞–∑–∏—Ç–µ–ª—å–Ω–æ–µ–∑–∞—Ä–∞–∑–∏—Ç—Å—è–∑–∞—Ä–∞–∑—è—Ç–∑–∞—Ä–∞–π—Å–∫–∑–∞—Ä–∞–π—Å–∫–µ–∑–∞—Ä–∞–Ω–µ–∑–∞—Ä–∞—Å—Ç–∞—é—â–∏—Ö–∑–∞—Ä–≤–∞–≤—à–µ–º—É—Å—è–∑–∞—Ä–≥–∑–∞—Ä–µ–≤–∞–Ω–Ω—É—é–∑–∞—Ä–µ–≤–∞–Ω–Ω—ã–µ–∑–∞—Ä–µ–≤–∫—É–∑–∞—Ä–µ–≤–Ω—É–µ—Ç–∑–∞—Ä–µ–≤—ë—Ç&–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä–æ–≤–∞–≤—à–∏—Å—å$–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä–æ–≤–∞–Ω–Ω—É—é–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä—É–µ—Ç"–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä—É–µ—Ç–µ—Å—å–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä—É–π–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä—É—é—Ç&–∑–∞—Ä–µ–≥—É–ª–∏—Ä–æ–≤–∞–Ω–Ω–æ—Å—Ç—å—é–∑–∞—Ä–µ–≥—É–ª–∏—Ä–æ–≤–∞–Ω–æ–∑–∞—Ä–µ–∂–µ–º–∑–∞—Ä–µ–∑–∞–∑–∞—Ä–µ–∑–∞–Ω–∞–∑–∞—Ä–µ–∑–∞–Ω–Ω—ã–π–∑–∞—Ä–µ–∑–∞–Ω—ã"–∑–∞—Ä–µ–∑–µ—Ä–≤–∏—Ä–æ–≤–∞–Ω–Ω–∞—è"–∑–∞—Ä–µ–∑–µ—Ä–≤–∏—Ä–æ–≤–∞–Ω–Ω—ã–º$–∑–∞—Ä–µ–∫–æ–º–µ–Ω–¥–æ–≤–∞–≤—à–µ–≥–æ"–∑–∞—Ä–µ–∫–æ–º–µ–Ω–¥–æ–≤–∞–≤—à–∏–µ"–∑–∞—Ä–µ–∫–æ–º–µ–Ω–¥–æ–≤–∞–≤—à–∏—Ö–∑–∞—Ä–µ–º–∞–∑–∞—Ä–µ–Ω–∏—Ü–∞–∑–∞—Ä–µ–Ω–∏—Ü—ã–∑–∞—Ä–µ–Ω–∫–æ–≤–∑–∞—Ä–µ—Å–ø–µ–∫—Ç–∏–ª–∑–∞—Ä–µ—á–µ