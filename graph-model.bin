–∑–∞–º—ë–ª–∑–∞–º—ë—Ä–∑–Ω—É–∑–∞–º—ë—Ä–∑—à–µ–º–∑–∞–º—ë—Ä–∑—à–∏–º–∑–∞–Ω–∞–≤–µ—Å–∏–ª–∞–∑–∞–Ω–∞–≤–µ—Å–∏—Ç—å–∑–∞–Ω–∞–≤–µ—à–µ–Ω—ã–∑–∞–Ω–¥–±–µ—Ä–≥–∑–∞–Ω–¥—Ä–∞—Ä—Ç–∑–∞–Ω–µ–º–µ–ª–∏–∑–∞–Ω–µ—Å–µ–Ω–Ω–∞—è–∑–∞–Ω–µ—Å—ë–Ω–Ω–æ–≥–æ–∑–∞–Ω–µ—Å—ë–Ω–Ω–æ–π–∑–∞–Ω–∏–∂–∞—Ç—å–∑–∞–Ω–∏–∂–µ–Ω–∏—è–∑–∞–Ω–∏–∂–µ–Ω–Ω–æ—Å—Ç–∏–∑–∞–Ω–∏–º–∞–≤—à–µ–µ—Å—è–∑–∞–Ω–∏–º–∞–≤—à—É—é—Å—è–∑–∞–Ω–Ω—É–∫–∑–∞–Ω–æ—á–µ–≤–∞–ª–∏–∑–∞–Ω—É–¥–Ω—ã–º–∑–∞–Ω—É–º–µ—Ä–æ–≤–∞—Ç—å–∑–∞–Ω—É–º–µ—Ä—É–µ–º–∑–∞–Ω—å–∫–æ–≤–µ—Ü–∫–æ–π–∑–∞–Ω—é—Ö–∞–Ω–Ω—ã–π–∑–∞–Ω—è–≤—à–µ–µ–∑–∞–Ω—è—Ç—å—è–∑–∞–æ–±–ª–∞—á–Ω—ã–π–∑–∞–æ–±–ª–∞—á–Ω—ã–º–∏–∑–∞–æ–∫–µ–∞–Ω—Å–∫–∏–π–∑–∞–æ–∫—Å–∫–∏–π–∑–∞–æ—Ä–µ—Ç–∑–∞–æ—Å—Ç—Ä—è—é—Ç–∑–∞–æ—Å—Ç—Ä—è—è–∑–∞–æ—Å—Ç—Ä—ë–Ω–Ω–∞—è–∑–∞–æ—Å—Ç—Ä—ë–Ω–Ω–æ–µ–∑–∞–ø–∞–¥–∞–µ—Ç$–∑–∞–ø–∞–¥–Ω–æ–∞—Ñ—Ä–∏–∫–∞–Ω—Å–∫–∞—è$–∑–∞–ø–∞–¥–Ω–æ–∞—Ñ—Ä–∏–∫–∞–Ω—Å–∫–∏–µ$–∑–∞–ø–∞–¥–Ω–æ–∞—Ñ—Ä–∏–∫–∞–Ω—Å–∫–æ–µ$–∑–∞–ø–∞–¥–Ω–æ–µ–≤—Ä–æ–ø–µ–π—Å–∫–æ–µ$–∑–∞–ø–∞–¥–Ω–æ—Å–ª–∞–≤—è–Ω—Å–∫–æ–≥–æ"–∑–∞–ø–∞–¥–Ω–æ—Å–ª–æ–≤–∞—Ü–∫–æ–≥–æ–∑–∞–ø–∞–¥–æ–∑–∞–ø–∞–∑–¥—ã–≤–∞—é—â–∏–µ–∑–∞–ø–∞–∑—É—Ö—É–∑–∞–ø–∞–ª–∏—Ç—å–∑–∞–ø–∞–ª—ã–∑–∞–ø–∞–Ω–∏–±—Ä–∞—Ç–∞–∑–∞–ø–∞—Ä–∏–ª–∑–∞–ø–∞—Å–∞–µ—Ç–∑–∞–ø–∞—Å–∞–Ω–∏–µ–∑–∞–ø–∞—Å–Ω–∏–∫–∏–∑–∞–ø–∞—Å–Ω–æ–º—É –∑–∞–ø–∞—Ç–µ–Ω—Ç–æ–≤–∞–Ω–Ω–æ–≥–æ–∑–∞–ø–∞—Ç–µ–Ω—Ç–æ–≤–∞–Ω–Ω–æ–µ–∑–∞–ø–∞—Ö–Ω—É–ª–∞—Å—å–∑–∞–ø–∞—á–∫–∞–ª–∞–∑–∞–ø–∞—á–∫–∞–ª–∏—Å—å–∑–∞–ø–∞—á–∫–∞–Ω–Ω—ã–µ–∑–∞–ø–∞—á–∫–∞—é—Ç—Å—è–∑–∞–ø–µ–≤–∞–ª–æ–π–∑–∞–ø–µ–∫–∞–Ω–∏–µ–∑–∞–ø–µ–∫–∞–Ω–∫–∏–∑–∞–ø–µ–∫–∞—Ç—å–∑–∞–ø–µ—Ä—å–∑–∞–ø–µ—á–∞—Ç–∞–ª–∏–∑–∞–ø–µ—á–∞—Ç–ª–µ–≤–∞–µ—Ç—Å—è–∑–∞–ø–µ—á–∞—Ç–ª–µ–≤–∞–ª–∑–∞–ø–µ—á–∞—Ç–ª–µ–≤–∞—è–∑–∞–ø–µ—á–∞—Ç—ã–≤–∞–ª–∑–∞–ø–µ—á–∞—Ç—ã–≤–∞–Ω–∏–µ–∑–∞–ø–µ—á–µ–Ω–Ω–∞—è–∑–∞–ø–µ—á–Ω—ã–π–∑–∞–ø–∏–≤–∞–ª–∞–∑–∞–ø–∏–Ω–∞–ª–∞—Å—å–∑–∞–ø–∏—Ä–∞–π–∑–∞–ø–∏—Ä–∞–ª–∞—Å—å–∑–∞–ø–∏—Å–∞–≤—à–∏–µ–∑–∞–ø–∏—Å—ã–≤–∞—é—Å—å–∑–∞–ø–∏—Å—ã–≤–∞—é—â–∏–º–∑–∞–ø–∏—Ç—É—é—Ç—å–∑–∞–ø–∏—Ö–∞–≤–∑–∞–ø–∏—â–∞–ª–∞–∑–∞–ø–ª–∞—Ç–∫–∞—Ö–∑–∞–ø–ª–∞—Ç—É–∑–∞–ø–ª–µ–ª–∑–∞–ø–ª–µ—Å–Ω–µ–≤–µ–ª–∞—è–∑–∞–ø–ª–µ—Ç–∞—è–∑–∞–ø–ª–µ—á–Ω–æ–≥–æ–∑–∞–ø–ª—ã–≤–æ–≤–∑–∞–ø–æ–≤–¥—å–∑–∞–ø–æ–≤–µ–¥–Ω–∏–∫—É–∑–∞–ø–æ–¥–æ–∑—Ä–µ–Ω–Ω—ã–π–∑–∞–ø–æ–∑–¥–∞