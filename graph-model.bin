–∑–∞–¥—É—é–∑–∞–¥—É—é—Ç–∑–∞–¥—ã–º–∏–ª–∏—Å—å–∑–∞–¥—ã–º–∏–ª—Å—è–∑–∞–¥—ã–º–ª–µ–Ω–∏—è–∑–∞–¥—ã—Ö–∞–≤—à–µ–π—Å—è–∑–∞–¥—ã—Ö–∞–µ—Ç–µ—Å—å–∑–∞–¥—ã—Ö–∞—é—â–∞—è—Å—è–∑–∞–¥—ã—Ö–∞—é—â–µ–≥–æ—Å—è–∑–∞–¥—ã—Ö–∞—é—â–∏–µ—Å—è–∑–∞–¥—ã—à–∞–≤–∑–∞–¥—ë—Ä–≥–∞–ª–∞—Å—å–∑–∞–¥—ë—Ä–Ω—É—Ç—ã–∑–∞–¥—ë—Ä–Ω—É—Ç—å–∑–∞–¥—ë—à–µ–≤–æ–∑–∞–µ–±–∞–ª–∏–∑–∞–µ–∑–¥–∏–ª–∑–∞–µ–∑–¥—É–∑–∞–µ–∑–∂–∞—é–∑–∞–µ–∑–∂–µ–Ω–Ω—ã–µ–∑–∞–µ–∫–∑–∞–µ—Å—Ç—å–∑–∞–∂–∞–ª—Å—è–∑–∞–∂–∞—Ä–µ–Ω–Ω–æ–≥–æ–∑–∞–∂–∞—Ä–µ–Ω–Ω—ã–µ–∑–∞–∂–∞—Ä—å–∑–∞–∂–≥—É—Ç–∑–∞–∂–µ–≤–∞–ª–∞–∑–∞–∂–∂–µ–Ω–Ω–æ–≥–æ–∑–∞–∂–∂–µ–Ω–Ω—ã–π–∑–∞–∂–∂—ë–Ω–Ω—ã—Ö–∑–∞–∂–∏–≤–∞—é—â–∏—Ö–∑–∞–∂–∏–≤–∏—Ç—å–∑–∞–∂–∏–≥–∞–ª–∫–∞–º–∏–∑–∞–∂–∏–≥–∞–ª–∫–µ–∑–∞–∂–∏–≥–∞—Ç–µ–ª—å–Ω–æ–∑–∞–∂–∏–≥–∞—Ç–µ–ª—å–Ω–æ–≥–æ–∑–∞–∂–∏–≥–∞—Ç—å—Å—è–∑–∞–∂–∏–ª–∏—Ç—å–∑–∞–∂–∏–ª—Å—è–∑–∞–∂–∏–º–∞–µ—Ç–µ–∑–∞–∂–∏–º–∞–µ—Ç—Å—è–∑–∞–∂–∏–º–∞–µ—à—å–∑–∞–∂–∏–º–∞–ª–∏–∑–∞–∂–∏–Ω–∫–∏–∑–∞–∂–∏—Ç–æ—á–Ω–æ—Å—Ç–∏–∑–∞–∂–º–µ—à—å–∑–∞–∂–º—É—Ä–µ–Ω–Ω—ã–º–∏–∑–∞–∂–º—É—Ä–∏–≤–∞–µ—Ç–∑–∞–∂–º—É—Ä–∏–≤–∞–µ—Ç—Å—è–∑–∞–∂–º—É—Ä–∏–≤–∞–ª–∑–∞–∂–º—É—Ä–∏–≤–∞—é–∑–∞–∂–º—É—Ä–∏—Ç—å–∑–∞–∂—É–∂–∂–∞–ª–∑–∞–∂—É–∂–∂–∞–ª–∞–∑–∞–∑–≤–∞—Ç—å–∑–∞–∑–≤–æ–Ω–∏–ª–∞–∑–∞–∑–µ–ª–µ–Ω–µ—Ç—å–∑–∞–∑–∏—Ä–∞–∑–∞–∑–Ω–∞–≤–∞–π—Å—è–∑–∞–∑–Ω–∞–π–∫–µ–∑–∞–∑–Ω–∞–π–∫–æ–π–∑–∞–∑–Ω–∞–π—Å—Ç–≤–æ–º–∑–∞–∑–Ω–∞–ª–∞—Å—å–∑–∞–∑–Ω–æ–±—É—à–∫—É–∑–∞–∑–Ω–æ–±—ã–∑–∞–∑–æ—Ä–æ–≤–∑–∞–∑–æ—Ä–æ–º–∑–∞–∑—É–±—Ä–µ–Ω–Ω—ã—Ö–∑–∞–∑—É–±—Ä–∏–Ω–∑–∞–∑—ã–≤–∞–Ω–∏—è–∑–∞–∏–∑–∞–∏–≥—Ä–∞–≤—à–∏—Å—å–∑–∞–∏–≥—Ä–∞—Ç—å–∑–∞–∏–∫–∑–∞–∏–∫–∞–µ—Ç–µ—Å—å–∑–∞–∏–∫–Ω—ë—à—å—Å—è–∑–∞–∏–ª–∏–≤–∞–Ω–∏—é–∑–∞–∏–ª–∏–π—Å–∫–æ–º–∑–∞–∏–º–µ–ª–∏–∑–∞–∏–º–æ–¥–∞–≤–µ—Ü–∑–∞–∏–º–æ–¥–∞–≤—Ü–∞–º–∑–∞–∏–º—Å—Ç–≤–æ–≤–∞–≤—à–∏—Ö–∑–∞–∏–º—Å—Ç–≤–æ–≤–∞–ª–∞—Å—å–∑–∞–∏–º—Å—Ç–≤–æ–≤–∞–Ω–Ω–æ–º—É –∑–∞–∏–Ω—Ç–µ—Ä–µ—Å–æ–≤–∞–≤—à–∏–µ –∑–∞–∏–Ω—Ç–µ—Ä–µ—Å–æ–≤—ã–≤–∞—Ç—å –∑–∞–∏–Ω—Ç–µ—Ä–µ—Å–æ–≤—ã–≤–∞—é—Ç–∑–∞–∏–Ω—Ç—Ä–∏–≥–æ–≤–∞–Ω–Ω–∞—è–∑–∞–∏–Ω—Ç—Ä–∏–≥–æ–≤–∞–Ω–Ω—ã–º–∑–∞–∏—Ä—Å–∫–æ–π–∑–∞–∏—Ä—Å–∫—É—é–∑–∞–∏—Å–∫–∏–≤–∞–µ—à—å–∑–∞–∏—Å–∫–∏–≤–∞–Ω–∏—è–∑–∞–∏—Å–∫–∏–≤–∞—é—â–∏–º–∑–∞–∏—Å–∫–∏–≤–∞—è–∑–∞–∏—Å–∫—Ä–∏–ª–∏–∑–∞–π–∫–æ–≤–æ–∑–∞–π–∫–æ–π–∑–∞–π–º–∞–µ–∑–∞–π—Ü–∞—Ö
–∑–∞–π—Ü–µ–∑–∞–π—Ü–µ–æ–±—Ä–∞–∑–Ω—ã–µ–∑–∞–π—á–∞—Ç–∑–∞–π—á–∞—Ç–∏–Ω–∞–∑–∞–π—á–∏–∫—É–∑–∞–∫–∞–≤–∫–∞–∑—Å–∫–æ–º—É–∑–∞–∫–∞–¥—Ä–æ–≤–æ–µ–∑–∞–∫–∞–¥—Ä–æ–≤–æ–º–∑–∞–∫–∞–¥—ã—á–Ω–∞—è–∑–∞–∫–∞–µ–≤–∞–∑–∞–∫–∞–∑–∏–∫–∑–∞–∫–∞–∑–Ω–∏–∫–∞–º–∏–∑–∞–∫–∞–∑–Ω–∏–∫–∞—Ö–∑–∞–∫–∞–∑–Ω–∏–∫–µ–∑–∞–∫–∞–∑—É—Ö–∞–∑–∞–∫–∞–∑—á–∏—Ü–µ–∑–∞–∫–∞–ª–∞–∑–∞–∫–∞–ª–µ–Ω–Ω—ã–º–∑–∞–∫–∞–ª–µ–Ω–Ω—ã—Ö–∑–∞–∫–∞–ª–∏–∑–∞–∫–∞–ª–∏–ª–∞–∑–∞–∫–∞–ª–∏–ª–∞—Å—å–∑–∞–∫–∞–ª—è—Ç—å—Å—è–∑–∞–∫–∞–ª—ë–Ω–Ω—É—é–∑–∞–∫–∞–º–µ–Ω–µ–ª–æ–∑–∞–∫–∞–º–µ–Ω—Å–∫–∏–π–∑–∞–∫–∞–º—Å–∫–æ–≥–æ–∑–∞–∫–∞–º—É—Ñ–ª–∏—Ä–æ–≤–∞–Ω–∞–∑–∞–∫–∞–º—å–µ–∑–∞–∫–∞–Ω—á–≤–∞–µ—Ü—Ü–∞–∑–∞–∫–∞–Ω—á–∏–≤–∞—é—â–∏–π–∑–∞–∫–∞–Ω—á–∏–≤–∞—é—â–∏–º—Å—è–∑–∞–∫–∞–ø–∞—Ç—å–∑–∞–∫–∞–ø–æ—Ç–∏—Ä–æ–≤–∞–Ω–∑–∞–∫–∞–ø–æ—Ç–∏—Ä–æ–≤–∞–Ω—ã–∑–∞–∫–∞–ø—Ä–∏–∑–Ω–∏—á–∞–ª–∑–∞–∫–∞–ø—ã–≤–∞–µ—Ç–µ–∑–∞–∫–∞–ø—ã–≤–∞–π–∑–∞–∫–∞–ø—ã–≤–∞–Ω–∏–∏–∑–∞–∫–∞—Ä–∏–∞–¥–∑–µ–∑–∞–∫–∞—Ä–∏–∞—Å–∑–∞–∫–∞—Ä–ø–∞—Ç—Å–∫—É—é–∑–∞–∫–∞—Ä—è–Ω–æ–≤–∑–∞–∫–∞—Ç–∞—Ö–∑–∞–∫–∞—Ç–∞—é—Ç–∑–∞–∫–∞—Ç–Ω—ã–π–∑–∞–∫–∞—Ç—ã–≤–∞–Ω–∏–µ–∑–∞–∫–∞—Ç—ã–≤–∞—é—Ç–∑–∞–∫–∞—á–∞–ª–∑–∞–∫–∞—á–∞–ª–∏–∑–∞–∫–∞—á–∏–≤–∞–Ω–∏—è–∑–∞–∫–∞—á–∫–æ–π–∑–∞–∫–∞—á–∫—É–∑–∞–∫–∞—à–ª—è—Ç—å—Å—è–∑–∞–∫–≤–∞–∫–∞–ª–∏–∑–∞–∫–∏–¥–∞–π–∑–∞–∫–∏–¥–∞–ª–∑–∞–∫–∏–¥–∞–ª–∞–∑–∞–∫–∏–¥–æ–Ω–∞–º–∑–∞–∫–∏–Ω—Ç–æ—Å–∑–∞–∫–∏–Ω—É–ª–æ–∑–∞–∫–∏–Ω—É–ª—Å—è–∑–∞–∫–∏–Ω—É—Ç–∑–∞–∫–∏–Ω—É—Ç–∞–∑–∞–∫–∏–Ω—Ñ–∑–∞–∫–∏–Ω—å—Ç–µ–∑–∞–∫–∏–ø–∞–π–∑–∞–∫–∏–ø–∞—é—Ç–∑–∞–∫–∏—Å–ª–∞–∑–∞–∫–∏—Å–Ω—É—Ç—å–∑–∞–∫–ª–∞–¥–∞–∑–∞–∫–ª–∞–¥–∫–∏name–∑–∞–∫–ª–∞–¥—ã–≤–∞–ª–∞—Å—å–∑–∞–∫–ª–µ–µ–Ω–Ω—ã–º–∏–∑–∞–∫–ª–µ–∏–ª–∑–∞–∫–ª–µ–π–º–µ–Ω–∑–∞–∫–ª–µ–π–º–µ–Ω–∞–∑–∞–∫–ª–µ–π–º–µ–Ω—ã–∑–∞–∫–ª–µ–π–º–∏–ª–æ–∑–∞–∫–ª–µ–π–º–∏—Ç–∑–∞–∫–ª–∏–Ω–∞–µ–º–∑–∞–∫–ª–∏–Ω–∞–µ—Ç–∑–∞–∫–ª–∏–Ω–∞—Ç–µ–ª–µ–π–∑–∞–∫–ª–∏–Ω–∞—è–∑–∞–∫–ª–∏–Ω–µ–Ω–∞–∑–∞–∫–ª–∏–Ω–∏–≤–∞–Ω–∏–µ–∑–∞–∫–ª–∏–Ω–∏–≤—à–∞—è—Å—è–∑–∞–∫–ª—É–±–∏–ª–∞—Å—å–∑–∞–∫–ª—é—á–∑–∞–∫–ª—é—á–∞–≤—à–∏—Ö—Å—è–∑–∞–∫–ª—é—á–∞—é—â–µ–≥–æ–∑–∞–∫–ª—é—á–∞—é—â–∏–º–∑–∞–∫–ª—é—á–∞—é—â–∏–º—Å—è–∑–∞–∫–ª—é—á–∏–∑–∞–∫–ª—é—á–∏—Ç–µ–ª—å–Ω—ã–º–∏–∑–∞–∫–ª—é—é—Ç–∑–∞–∫–ª—è—Ç–æ–º–∑–∞–∫–ª—ë–ø–æ–∫–∑–∞–∫–æ–≤–∞–∑–∞–∫–æ–≤–∞–ª–∞–∑–∞–∫–æ–≤–∞–Ω–∞–∑–∞–∫–æ–≤–∞–Ω–Ω–æ–π–∑–∞–∫–æ–≤–∞–Ω–Ω—É—é–∑–∞–∫–æ–≤–∞–Ω–Ω—ã–º–∑–∞–∫–æ–≤—ã–≤–∞–µ—Ç–∑–∞–∫–æ–≤—ã–≤–∞–ª–∏–∑–∞–∫–æ–≤—ã–≤–∞—é—Ç–∑–∞–∫–æ–≤—ã–∫–∞–∑–∞–∫–æ–≤—ã–ª—è–ª–∏–∑–∞–∫–æ–≤—ã—Ä–∏—Å—Ç—ã–µ–∑–∞–∫–æ–≤—ã—Ä–∏—Å—Ç—ã–º–∏–∑–∞–∫–æ–≤—ã—Ä–∫–∞–∑–∞–∫–æ–¥–∏—Ä–æ–≤–∞–Ω–Ω–∞—è–∑–∞–∫–æ–¥–∏—Ä–æ–≤–∞–Ω–Ω–æ–π–∑–∞–∫–æ–¥–∏—Ä–æ–≤–∞–Ω–Ω—ã–º–∑–∞–∫–æ–ª–¥–æ–≤–∞–Ω–∞–∑–∞–∫–æ–ª–¥–æ–≤–∞–Ω–Ω—ã—Ö–∑–∞–∫–æ–ª–¥–æ–≤—ã–≤–∞—Ç—å–∑–∞–∫–æ–ª–µ–±–∞–ª–∏—Å—å–∑–∞–∫–æ–ª–µ—Ç–∑–∞–∫–æ–ª–µ—à—å–∑–∞–∫–æ–ª–æ—á–µ–Ω–∑–∞–∫–æ–ª–æ—á–µ–Ω–Ω–æ–π–∑–∞–∫–æ–ª–æ—á–µ–Ω–Ω—ã–π–∑–∞–∫–æ–ª—å—Ü–æ–≤–∞–Ω–∑–∞–∫–æ–ª—å—Ü–æ–≤–∞–Ω–∞–∑–∞–∫–æ–ª—å—Ü–æ–≤–∞–Ω–Ω–∞—è"–∑–∞–∫–æ–º–ø–ª–µ–∫—Å–æ–≤–∞–Ω–Ω—ã–º–∑–∞–∫–æ–Ω–≤–∑–∞–∫–æ–Ω–Ω–∫–∞–≤–∞–∑–∞–∫–æ–Ω–æ–≤–µ–¥–æ–º –∑–∞–∫–æ–Ω–æ–¥–∞—Ç–µ–ª—å–Ω–∏—Ü—ã–∑–∞–∫–æ–Ω–æ–º–µ—Ä–Ω—ã–º–∏–∑–∞–∫–æ–Ω–æ–ø–∞—Ç–∏—Ç—å–∑–∞–∫–æ–Ω–æ–ø–æ–ª–æ–∂–µ–Ω–∏–π –∑–∞–∫–æ–Ω–æ–ø–æ—Å–ª—É—à–∞–Ω–∏—è–∑–∞–∫–æ–Ω–æ–ø—Ä–æ–µ–∫—Ç–Ω–æ–π(–∑–∞–∫–æ–Ω–æ—Å–æ–≤–µ—â–∞—Ç–µ–ª—å–Ω–æ–≥–æ&–∑–∞–∫–æ–Ω–æ—Å–æ–≤–µ—â–∞—Ç–µ–ª—å–Ω—ã–π–∑–∞–∫–æ–Ω–æ—É—á–∏—Ç–µ–ª—è–º–∏ –∑–∞–∫–æ–Ω—Å–µ—Ä–≤–∏—Ä–æ–≤–∞–ª–∏$–∑–∞–∫–æ–Ω—Å–µ—Ä–≤–∏—Ä–æ–≤–∞–Ω–Ω—ã–º$–∑–∞–∫–æ–Ω—Å–ø–∏—Ä–∏—Ä–æ–≤–∞–Ω–Ω—É—é–∑–∞–∫–æ–Ω—á–∏–≤—à–∞—è–∑–∞–∫–æ–Ω—á–∏–≤—à–µ–µ–∑–∞–∫–æ–Ω—á–∏–≤—à–∏–µ–∑–∞–∫–æ–Ω—á–∏–≤—à–∏–º–∏—Å—è–∑–∞–∫–æ–ø–∞–≤—à–∏—Å—å–∑–∞–∫–æ–ø–∞–π—Ç–µ–∑–∞–∫–æ–ø–∞–ª–∞—Å—å–∑–∞–∫–æ–ø–∞–Ω–Ω—ã–π–∑–∞–∫–æ–ø—á–µ–Ω–Ω—ã—Ö–∑–∞–∫–æ—Ä–µ–Ω–µ–ª—É—é–∑–∞–∫–æ—Ä–∫–∏–∑–∞–∫–æ—Ä–º–∏—Ç—å–∑–∞–∫–æ—Ä–æ—Ç–∏–ª–∑–∞–∫–æ—Ä—é—á–∫—É–∑–∞–∫–æ—Å—Ç–µ–Ω–µ–≤—à–µ–π–∑–∞–∫–æ—Å—Ç–µ–Ω–µ–ª–∏–∑–∞–∫–æ—Å—Ç–µ–Ω–µ–ª—ã–º–∏–∑–∞–∫–æ—É–ª–∫–∞–º–∏–∑–∞–∫–æ—É–ª–æ—á–∫–∞–º–∑–∞–∫–æ—á–µ–Ω–µ–ª–∑–∞–∫—Ä–∞—à–µ–Ω–∑–∞–∫—Ä–∞—à–∏–≤–∞–ª–∑–∞–∫—Ä–µ–ø–∏–≤—à–∞—è—Å—è–∑–∞–∫—Ä–µ–ø–∏–≤—à–∏—Ö—Å—è–∑–∞–∫—Ä–µ–ø–∏—Ç—Å—è–∑–∞–∫—Ä–µ–ø–ª–µ–Ω–Ω—É—é–∑–∞–∫—Ä–µ–ø–ª—è–≤—à–∞—è–∑–∞–∫—Ä–µ–ø–ª—è–µ–º—ã–µ–∑–∞–∫—Ä–µ–ø–ª—è—é—â–∞—è–∑–∞–∫—Ä–µ–ø–ª—è—é—â–∏–µ–∑–∞–∫—Ä–µ–ø–ª—è—é—â–∏—Ö–∑–∞–∫—Ä–µ–ø–æ—â–µ–Ω—ã–∑–∞–∫—Ä–∏–≤–∞–≤–ª–µ–Ω–µ–∑–∞–∫—Ä–æ–π—Ç–µ—Å—å–∑–∞–∫—Ä—É–≥–ª–µ–Ω–∏—è–∑–∞–∫—Ä—É–≥–ª–µ–Ω–Ω—ã–π–∑–∞–∫—Ä—É–≥–ª–∏–º—Å—è–∑–∞–∫—Ä—É–≥–ª–∏—Ç—å–∑–∞–∫—Ä—É–∂–∏–ª–æ–∑–∞–∫—Ä—É–∂—É–∑–∞–∫—Ä—É—Ç–∏—à—å–∑–∞–∫—Ä—É—á–µ–Ω–∞–∑–∞–∫—Ä—É—á–µ–Ω–Ω–∞—è–∑–∞–∫—Ä—É—á–µ–Ω–Ω—ã—Ö–∑–∞–∫—Ä—É—á–∏–≤–∞–ª–∑–∞–∫—Ä—É—á–∏–≤–∞–ª–æ—Å—å–∑–∞–∫—Ä—É—á–∏–≤–∞–Ω–∏–µ–º–∑–∞–∫—Ä—É—á–∏–≤–∞—Ç—å—Å—è–∑–∞–∫—Ä—É—á–∏–≤–∞—é—Ç–∑–∞–∫—Ä—É—á–∏–≤–∞—é—â–∏–µ—Å—è–∑–∞–∫—Ä—É—á–∏–Ω–∏–ª–∞—Å—å–∑–∞–∫—Ä—ã–≤–∞–µ–º–∞—è–∑–∞–∫—Ä—ã–≤—à–∞—è—Å—è–∑–∞–∫—Ä—ã–≤—à–∏—Ö–∑–∞–∫—Ä—ã–≤—à—É—é—Å—è–∑–∞–∫—Ä—ã–ª–∫–æ–≤–∑–∞–∫—É–∫–∞—Ä–µ–∫–∞–µ—à—å–∑–∞–∫—É–ª–∏—Å–Ω–æ–µ–∑–∞–∫—É–ª–∏—Å—å–µ
