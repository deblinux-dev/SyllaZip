–Ω–µ–∞—Ä—Ö–Ω–µ–±–µ–ª–∫–æ–≤–æ–π–Ω–µ–±–ª–∞–≥–æ–≤–∏–¥–Ω—É—é–Ω–µ–±–ª–∞–≥–æ–¥–∞—Ä–Ω–∞–Ω–µ–±–ª–∞–≥–æ–ø–æ–ª—É—á–∏–∏–Ω–µ–±–ª–∞–≥–æ—Ä–æ–¥–Ω—ã–µ–Ω–µ–±–æ–≥–∞—Ç—É—é–Ω–µ–±–æ–µ—Å–ø–æ—Å–æ–±–Ω—ã–Ω–µ–±–æ–π—Å—å–Ω–µ–±—Ä–µ–∂–µ–Ω–∏—è–Ω–µ–±—Ä–∏—Ç–æ–π–Ω–µ–±—Ä–æ–Ω–µ–≤–æ–π–Ω–µ–≤–∞–¥—Å–∫–æ–≥–æ–Ω–µ–≤–∞–∂–Ωo–Ω–µ–≤–∞–∂–Ω–æ–º–Ω–µ–≤–µ–∂–∏–Ω–Ω–µ–≤–µ–∂–ª–∏–≤–∞–Ω–µ–≤–µ–∂—É–Ω–µ–≤–µ–ª—å—Å–∫–æ–π–Ω–µ–≤–µ—Ä–±–∞–ª—å–Ω—ã—Ö–Ω–µ–≤–µ—Ä–ª–µ–Ω–¥–Ω–µ–≤–µ—Å–µ–ª–æ–º–Ω–µ–≤–µ—Å–æ–º–∞–Ω–µ–≤–∑–∞–∏–º–Ω—ã–π–Ω–µ–≤–∑–≥–æ–¥–∞–Ω–µ–≤–∏–¥–∞–Ω–Ω–æ–º–Ω–µ–≤–∏–Ω–∫–µ–Ω–µ–≤–∫—É—Å–Ω—É—é–Ω–µ–≤–Ω–∏–º–∞—Ç–µ–ª—å–Ω—ã–µ–Ω–µ–≤–Ω—è—Ç–Ω—ã–º–∏–Ω–µ–≤–æ–∑–≤—Ä–∞—â–µ–Ω—Ü–µ–≤–Ω–µ–≤–æ–∑–º—É—Ç–∏–º—É—é–Ω–µ–≤–æ–∑–º—É—Ç–∏–º—ã–Ω–µ–≤–æ–æ—Ä—É–∂–µ–Ω–Ω–æ–≥–æ–Ω–µ–≤–æ—Å–ø–∏—Ç–∞–Ω–Ω–æ$–Ω–µ–≤–æ—Å—Ç—Ä–µ–±–æ–≤–∞–Ω–Ω–æ—Å—Ç—å–Ω–µ–≤—Ä–æ–ª–æ–≥–∏—á–µ—Å–∫–æ–º–Ω–µ–≤—Ä–æ–ª–æ–≥–∏—á–µ—Å–∫—É—é–Ω–µ–≤—Å–∫–∏–µ–Ω–µ–≤—Å–∫–∏—Ö–Ω–µ–≤—ã–≥–æ–¥–Ω—ã–º–∏–Ω–µ–≤—ã–ø–æ–ª–Ω–∏–º–æ–≥–æ–Ω–µ–≤—ã–ø–æ–ª–Ω–∏–º—ã–º–∏–Ω–µ–≤—ã—Ä–∞–∑–∏–º—ã–µ–Ω–µ–≤—ã—Ä–∞–∑–∏–º—ã–π–Ω–µ–≥–∞—Å–∏–º–æ–π–Ω–µ–≥–∞—Å–∏–º—ã–π–Ω–µ–≥–∞—Å–Ω—É—â–∏–µ–Ω–µ–≥–ª–∏–Ω–Ω—É—é–Ω–µ–≥–æ–¥–Ω—É—é–Ω–µ–≥–æ—Ç–æ–≤–Ω–æ—Å—Ç—å—é–Ω–µ–≥–æ—Ü–∏–∞–Ω—Ç–∞–Ω–µ–≥–æ—Ü–∏–∞–Ω—Ç—ã–Ω–µ–≥–æ—Ü–∏—è–Ω–µ–≥—Ä–∞–∂–¥–∞–Ω–Ω–µ–≥—Ä–∞–ø–æ–Ω—Ç–æ–≤–Ω–µ–≥—Ä–µ—Å–∫–æ–Ω–µ–≥—Ä–∏—Ç–æ—Å—ã–Ω–µ–≥—Ä–∏—Ç—è–Ω–∫–µ–Ω–µ–≥—Ä–∏—Ç—è–Ω—Å–∫–∏–º–Ω–µ–≥—Ä–æ–º–∫–∏—Ö–Ω–µ–≥—Ä–æ–ø–æ–Ω—Ç–µ–Ω–µ–¥–∞–ª–µ–∫–æ–µ–Ω–µ–¥–∞–ª—å–Ω–æ–≤–∏–¥–Ω—ã–Ω–µ–¥–∞–ª—å–Ω–æ–≤–∏–¥–Ω—ã–º–Ω–µ–¥–∞–ª—å–Ω–æ–≤–∏–¥–Ω—ã–º–∏–Ω–µ–¥–∞–ª—å–Ω–æ–≤–∏–¥–Ω—ã—Ö–Ω–µ–¥–≤–∏–∂–Ω—ã–π
–Ω–µ–¥–µ–ª–Ω–µ–¥–µ–ª—å–∫–æ(–Ω–µ–¥–∏—Å—Ü–∏–ø–ª–∏–Ω–∏—Ä–æ–≤–∞–Ω–Ω—ã—Ö&–Ω–µ–¥–æ–±—Ä–æ–∂–µ–ª–∞—Ç–µ–ª—å–Ω–æ–≥–æ –Ω–µ–¥–æ–±—Ä–æ—Å–æ–≤–µ—Å—Ç–Ω–æ–µ–Ω–µ–¥–æ–≥–∞–¥–ª–∏–≤—ã–π –Ω–µ–¥–æ–≥–æ–≤–æ—Ä–µ–Ω–Ω–æ—Å—Ç–∏–Ω–µ–¥–æ–¥–µ–ª–∞–Ω–Ω—ã—Ö–Ω–µ–¥–æ–µ–¥–∞–Ω–∏–∏–Ω–µ–¥–æ–∂–¥—É—Å—å–Ω–µ–¥–æ–∫–æ—Ä–º–ª–µ–Ω—ã–Ω–µ–¥–æ–ª—é–±–ª–∏–≤–∞—Ç—å–Ω–µ–¥–æ–Ω–µ—Å–µ–Ω–∏–µ–Ω–µ–¥–æ–Ω–æ—Å–∫–æ–º–Ω–µ–¥–æ–æ—Ü–µ–Ω–µ–Ω—ã–Ω–µ–¥–æ–æ—Ü–µ–Ω–∏–≤–Ω–µ–¥–æ–æ—Ü–µ–Ω–∏–≤–∞–π—Ç–µ–Ω–µ–¥–æ–ø–æ–Ω—è–ª–∏–Ω–µ–¥–æ–ø—É—Å—Ç–∏–º–æ–≥–æ–Ω–µ–¥–æ—Ä–∞–∑–≤–∏—Ç–æ–π–Ω–µ–¥–æ—Ä–æ—Å–ª—è–Ω–µ–¥–æ—Ä—É–±–æ–≤–Ω–µ–¥–æ—Å–º–æ—Ç—Ä–µ–ª–∏–Ω–µ–¥–æ—Å—Ç–∏–∂–∏–º–æ–µ–Ω–µ–¥–æ—Å—Ç–∏–∂–∏–º—ã–π–Ω–µ–¥–æ—Å—Ç–æ–≤–µ—Ä–Ω–∞–Ω–µ–¥–æ—Å—è–≥–∞–µ–º–æ–º–Ω–µ–¥–æ—Å—è–≥–∞–µ–º—ã–µ–Ω–µ–¥–æ—Ç–µ–ø–Ω–µ–¥–æ—É–º–µ–≤–∞—é—â–µ–≥–æ–Ω–µ–¥–æ—É–º–µ–≤–∞—é—â–∏–µ–Ω–µ–¥–æ—É–º–µ–≤–∞—é—â–∏–º–Ω–µ–¥—Ä—É–≥—É–Ω–µ–¥—Ä—É–∂–µ–ª—é–±–Ω–æ–≥–æ–Ω–µ–¥—Ä—É–∂–µ–ª—é–±–Ω—ã–Ω–µ–¥—è–ª–∫–æ–≤–Ω–µ–µ–≤—Ä–µ–∏
–Ω–µ–µ–ª—å–Ω–µ–µ–º–∏—è–Ω–µ–µ—Å—Ç–µ—Å—Ç–≤–µ–Ω–Ω—É—é–Ω–µ–∂–∞—Ä–∫–æ–Ω–µ–∂–¥–∞–Ω–Ω–æ–º—É–Ω–µ–∂–µ–ª–∞—Ç–µ–ª—å–Ω–∞—è–Ω–µ–∂–µ–ª–∞—Ç–µ–ª—å–Ω–æ—Å—Ç—å
–Ω–µ–∂–∏–ª–Ω–µ–∂–∏–ª–∏—Å—å–Ω–µ–∂–∏–Ω–∞–Ω–µ–∑–∞–Ω–µ–∑–∞–≤–µ—Ä—à–µ–Ω–Ω–∞—è–Ω–µ–∑–∞–≤–µ—Ä—à—ë–Ω–Ω–æ—Å—Ç—å–Ω–µ–∑–∞–¥–∞—á–ª–∏–≤–æ–º—É –Ω–µ–∑–∞–¥—Ä–∞—Ñ—Ç–æ–≤–∞–Ω–Ω—ã–µ–Ω–µ–∑–∞–∂–∏–≤–∞—é—â–∏—Ö$–Ω–µ–∑–∞–∫–æ–Ω–Ω–æ—Ä–æ–∂–¥–µ–Ω–Ω—ã—Ö–Ω–µ–∑–∞–∫—Ä—ã—Ç—ã–µ –Ω–µ–∑–∞–º–µ–¥–ª–∏—Ç–µ–ª—å–Ω–∞—è–Ω–µ–∑–∞–º–µ—Ä–∑–∞—é—â–∏–π–Ω–µ–∑–∞–º–µ—á–µ–Ω–Ω—ã–µ–Ω–µ–∑–∞–º—É—Ç–Ω—ë–Ω–Ω–æ–µ–Ω–µ–∑–∞–Ω—è—Ç–æ–π–Ω–µ–∑–∞–ø–Ω–æ–Ω–µ–∑–∞–ø–æ–ª–Ω–µ–Ω–Ω—ã–º–Ω–µ–∑–∞—Å–ª—É–∂–µ–Ω–Ω—ã–π–Ω–µ–∑–∞—Ç—Ä–æ–Ω—É—Ç—ã–º–∏–Ω–µ–∑–∞—Ç—Ä–æ–Ω—É—Ç—ã—Ö–Ω–µ–∑–µ–º–Ω–æ–º—É–Ω–µ–∑–Ω–∞–π–∫–æ–π–Ω–µ–∏–≥—Ä–æ–≤—ã–µ–Ω–µ–∏–≥—Ä–æ–≤—ã–º–∏–Ω–µ–∏–∑–≤–µ–¥–∞–Ω–Ω–æ–º–Ω–µ–∏–∑–º–µ–Ω—è–µ–º—ã—Ö–Ω–µ–∏–∑—ä—è—Å–Ω–∏–º–æ–π–Ω–µ–∏–º–µ–Ω–∏—è–Ω–µ–∏–Ω—Ç–µ–ª–ª–∏–≥–µ–Ω—Ç–Ω–æ–Ω–µ–∏—Å–ø–æ–ª–Ω–µ–Ω–∏–µ–º–Ω–µ–∏—Å–ø—Ä–∞–≤–∏–º–æ–≥–æ–Ω–µ–∏—Å—Å–ª–µ–¥–æ–≤–∞–Ω–Ω—ã–º–Ω–µ–∏—Å—Ç—Ä–µ–±–∏–º–æ–Ω–µ–∏—Å—Ç—Ä–µ–±–∏–º–æ–π–Ω–µ–∏—Å—Ç—Ä–µ–±–∏–º—ã–π–Ω–µ–∏—Å—á–∏—Å–ª–∏–º—ã–π
–Ω–µ–π–ª–ª–Ω–µ–π–º–µ–≥–µ–Ω–µ–Ω–µ–π—Ä–æ–∫–æ–º–ø—å—é—Ç–µ—Ä—ã–Ω–µ–π—Ä–æ–∫–æ—Ä–ø –Ω–µ–π—Ä–æ–ª–µ–ø—Ç–∏—á–µ—Å–∫–æ–π–Ω–µ–π—Ä–æ–Ω–Ω–æ–≥–æ–Ω–µ–π—Ä–æ–ø–µ–ø—Ç–∏–¥—ã–Ω–µ–π—Ä–æ—Ö–∏—Ä—É—Ä–≥–∏&–Ω–µ–π—Ä–æ—Ö–∏—Ä—É—Ä–≥–∏—á–µ—Å–∫–æ–≥–æ–Ω–µ–π—Å—Å–µ–Ω–µ–π—Ç—Ä–∞–ª–∫–µ–Ω–µ–∫–∞–∑–∏—Å—Ç–æ–π–Ω–µ–∫–∞–Ω–æ–Ω–∏—á–µ—Å–∫–∞—è–Ω–µ–∫–∞–Ω–æ–Ω–∏—á–µ—Å–∫–æ–º–Ω–µ–∫–∞—á–µ—Å—Ç–≤–µ–Ω–Ω—É—é(–Ω–µ–∫–ª–∞—Å—Å–∏—Ñ–∏—Ü–∏—Ä–æ–≤–∞–Ω–Ω—ã—Ö$–Ω–µ–∫–ª–∞—Å—Å–∏—Ñ–∏—Ü–∏—Ä—É–µ–º—ã–µ–Ω–µ–∫–ª—é–¥–æ–≤–∞–Ω–µ–∫–æ–º–º–µ—Ä—á–µ—Å–∫–æ–º–Ω–µ–∫–æ–º–ø–µ—Ç–µ–Ω—Ç–Ω–∞—è"–Ω–µ–∫–æ–Ω—Å—Ç–∏—Ç—É—Ü–∏–æ–Ω–Ω–æ–π–Ω–µ–∫–æ–Ω—Ç–∞–∫—Ç–Ω—ã–π–Ω–µ–∫–æ—Ä—Ä–µ–∫—Ç–Ω—ã–Ω–µ–∫—Ä–∞—Å–æ–≤–∫–∏–Ω–µ–∫—Ä–∞—à–µ–Ω—ã–µ–Ω–µ–∫—Ä–∏—Ç–∏—á–µ—Å–∫–∏–Ω–µ–∫—Ä–æ–Ω–æ–º–µ–∫–æ–Ω–Ω–µ–∫—Ä—É–ø–Ω—ã–º–Ω–µ–ª–µ–≥–∞–ª—å–Ω–æ–º—É–Ω–µ–ª–µ–≥–∏—Ç–∏–º–Ω–æ—Å—Ç–∏–Ω–µ–ª–µ—Å—Ç–Ω—ã—Ö–Ω–µ–ª–µ—á–∫–∞–Ω–µ–ª–∏–±–µ—Ä–∞–ª—å–Ω–∞—è–Ω–µ–ª–∏–±–µ—Ä–∞–ª—å–Ω—ã—Ö
–Ω–µ–ª–ª–µ–Ω–µ–ª–ª–∏—Å–Ω–µ–ª—é–¥—è–º–∏–Ω–µ–ª—ë—Ç–Ω–æ–π
–Ω–µ–º–∞–µ–Ω–µ–º–∞–ª–µ–Ω—å–∫–æ–µ–Ω–µ–º–∞–Ω—É
–Ω–µ–º–µ–Ω–Ω–µ–º–µ—Ü–∫–æ—è–∑—ã—á–Ω–æ–µ–Ω–µ–º–µ—Ü–∫–æ—è–∑—ã—á–Ω—ã–µ–Ω–µ–º–∏–Ω—É—á–∞—è–Ω–µ–º–∏—Ä–æ–≤–µ–Ω–µ–º–∏—Ä–æ–≤–∏—á–µ–º–Ω–µ–º–Ω–æ–≥–æ–º—É–Ω–µ–º–Ω–æ–≥–æ—Å–ª–æ–≤–Ω–∞–Ω–µ–º–Ω–æ–≥–æ—Å–ª–æ–≤–Ω—ã–Ω–µ–º–æ–∂–µ—Ç–Ω–µ–º–æ—Ç–∏–≤–∏—Ä–æ–≤–∞–Ω–Ω–æ–Ω–µ–º–æ—Ç–æ–π–Ω–µ–º–æ—â–Ω–æ–Ω–µ–º—Ä–Ω–µ–º—É–¥—Ä–µ–Ω—ã–π–Ω–µ–º—á–∏–∫–Ω–µ–º—á–∏–Ω–æ–≤–∫–∞–Ω–µ–º—ã—Ç—É—é–Ω–µ–º—ã—Ç—ã–º –Ω–µ–Ω–∞–≤–∏—Å—Ç–Ω–∏—á–µ—Å–∫–∏–µ–Ω–µ–Ω–∞–≤–∏—Å—Ç–Ω–æ–º–Ω–µ–Ω–∞–≥–ª—è–¥–Ω—ã–º–Ω–µ–Ω–∞–¥–µ–∂–Ω–æ–≥–æ–Ω–µ–Ω–∞–¥—ë–∂–Ω–æ—Å—Ç—å—é–Ω–µ–Ω–∞–¥—ë–∂–Ω—É—é–Ω–µ–Ω–∞–∑–≤–∞–Ω–Ω–æ–º—É–Ω–µ–Ω–∞–ø–∏—Å–∞–Ω–Ω—ã–µ–Ω–µ–Ω–∞—Ä–æ–∫–æ–≤–Ω–µ–Ω–∞—Å—Ç–∏–π–Ω–µ–Ω–æ—Ä–º–∞–ª—å–Ω–æ–º—É–Ω–µ–Ω—É–ª–µ–≤–∞—è–Ω–µ–Ω—É–ª–µ–≤—ã–º–Ω–µ–Ω—å–∫–∞–Ω–µ–æ–±–¥—É–º–∞–Ω–Ω–æ–π–Ω–µ–æ–±–∏—Ç–∞–µ–º—ã–º–∏–Ω–µ–æ–±–æ–∑—Ä–∏–º–∞—è–Ω–µ–æ–±–æ–∑—Ä–∏–º–æ–π–Ω–µ–æ–±–æ–∑—Ä–∏–º—ã–π –Ω–µ–æ–±–æ—Å–Ω–æ–≤–∞–Ω–Ω–æ—Å—Ç–∏–Ω–µ–æ–±—Ä–∞–∑–æ–≤–∞–Ω–Ω—ã–Ω–µ–æ–±—É–∑–¥–∞–Ω–Ω–æ—Å—Ç—å–Ω–µ–æ–±—É—á–µ–Ω–Ω—ã–µ–Ω–µ–æ–±—ä—è—Ç–Ω–æ—Å—Ç—å–Ω–µ–æ–±—ä—è—Ç–Ω—ã–º–∏–Ω–µ–æ–≥–æ—Ç–∏–∫–∞–Ω–µ–æ–¥–Ω–æ–∫—Ä–∞—Ç–Ω–∞—è–Ω–µ–æ–¥–Ω–æ—Ä–æ–¥–Ω–æ–µ–Ω–µ–æ–¥–æ–±—Ä–∏—Ç–µ–ª—å–Ω—ã–µ–Ω–µ–æ–¥–æ–±—Ä–∏—Ç–µ–ª—å–Ω—ã–π–Ω–µ–æ–∂–∏–¥–∞–Ω–Ω–æ—Å—Ç—è–º–∏–Ω–µ–æ–∫–æ–ª—å–∫–æ–Ω–µ–æ–ª–∏—Ç–µ–Ω–µ–æ–ª–∏—Ç–∏—á–µ—Å–∫–æ–≥–æ–Ω–µ–æ–Ω—É–∞—Ä–Ω–µ–æ–ø–∞—Å–Ω—ã–Ω–µ–æ–ø–µ—Ä—ë–Ω–Ω–∞—è–Ω–µ–æ–ø–æ–∑–Ω–∞–Ω–Ω–æ–º–Ω–µ–æ–ø—Ä–∞–≤–¥–∞–Ω–Ω–æ–º–Ω–µ–æ–ø—Ä–µ–¥–µ–ª—ë–Ω–Ω–∞–Ω–µ–æ–ø—Ä–µ–¥–µ–ª—ë–Ω–Ω—É—é–Ω–µ–æ–ø—Ä–æ–≤–µ—Ä–∂–∏–º—ã–º–∏–Ω–µ–æ–ø—Ä—è—Ç–Ω–∞—è–Ω–µ–æ–ø—Ä—è—Ç–Ω—É—é–Ω–µ–æ–ø—Ç–æ–ª–µ–º$–Ω–µ–æ—Ä–≥–∞–Ω–∏–∑–æ–≤–∞–Ω–Ω–æ—Å—Ç—å–Ω–µ–æ—Ä–¥–∏–Ω–∞—Ä–Ω—É—é –Ω–µ–æ—Ä—Ç–æ–¥–æ–∫—Å–∞–ª—å–Ω—ã–µ–Ω–µ–æ—Å–ª–∞–±–µ–≤–∞—é—â–∏–º–Ω–µ–æ—Å—É—â–µ—Å—Ç–≤–∏–º–∞—è–Ω–µ–æ—Å—É—â–µ—Å—Ç–≤–∏–º—ã–µ –Ω–µ–æ—Å—É—â–µ—Å—Ç–≤–ª—ë–Ω–Ω—ã–π–Ω–µ–æ—Å—é—Ä—Ä–µ–∞–ª–∏–∑–º–Ω–µ–æ—Ç–≤—Ä–∞—Ç–∏–º–æ—Å—Ç—å—é–Ω–µ–æ—Ç–ª–∏—á–∏–º—ã–º–∏–Ω–µ–æ—Ç—Ä–æ–ø–∏—á–µ—Å–∫–∏–µ–Ω–µ–æ—Ñ–∏—Ç—É–Ω–µ–æ—Ñ–∏—Ç—ã–Ω–µ–æ—Ñ–∏—Ü–Ω–µ–æ—Ü–µ–Ω–∏–º–Ω–µ–æ—á–µ–≤–∏–¥–Ω—ã–º–Ω–µ–æ—á–∏—â–µ–Ω–Ω—ã–π–Ω–µ–ø–∞–∑–±–µ–∂–Ω–∞–Ω–µ–ø–∞–ª–æ–º–Ω–µ–ø–µ–π—Ü—ã–Ω—ã–Ω–µ–ø–µ—Ä–∞–Ω–µ–ø–µ—Ä–µ–≤–æ–¥–∏–º—ã–π–Ω–µ–ø–µ—Ä–µ—Å—Ç–∞–≤–∞—è–