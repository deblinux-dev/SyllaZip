–Ω–µ–¥–∞–Ω–Ω–µ–¥–≤–∏–∂–Ω–æ–≥–æ–Ω–µ–¥–≤–∏–∂–Ω–æ–π–Ω–µ–¥–≤–∏–∂–Ω—ã–µ–Ω–µ–¥–≤–∏–∂–Ω—ã–π–Ω–µ–¥–≤—É—Å–º—ã—Å–ª–µ–Ω–Ω—É—é–Ω–µ–¥–≤—É—Å–º—ã—Å–ª–µ–Ω–Ω—ã –Ω–µ–¥–≤—É—Å–º—ã—Å–ª–µ–Ω–Ω—ã–º–∏–Ω–µ–¥–µ–µ—Å–ø–æ—Å–æ–±–µ–Ω"–Ω–µ–¥–µ–µ—Å–ø–æ—Å–æ–±–Ω–æ—Å—Ç—å—é–Ω–µ–¥–µ–µ—Å–ø–æ—Å–æ–±–Ω—ã–π–Ω–µ–¥–µ–µ—Å–ø–æ—Å–æ–±–Ω—ã–º–∏–Ω–µ–¥–µ–∑–∞—Ä–≥–æ–≤–∞ –Ω–µ–¥–µ–π—Å—Ç–≤–∏—Ç–µ–ª—å–Ω–æ–µ$–Ω–µ–¥–µ–π—Å—Ç–≤–∏—Ç–µ–ª—å–Ω–æ—Å—Ç–∏ –Ω–µ–¥–µ–π—Å—Ç–≤–∏—Ç–µ–ª—å–Ω—ã–µ–Ω–µ–¥–µ–ª–∞–Ω–∏–µ–Ω–µ–¥–µ–ª–∏–º–Ω–µ–¥–µ–ª–∏–º–æ–Ω–µ–¥–µ–º–æ–∫—Ä–∞—Ç–∏—á–µ–Ω$–Ω–µ–¥–µ–º–æ–∫—Ä–∞—Ç–∏—á–µ—Å–∫–æ–≥–æ–Ω–µ–¥–µ–º–æ–∫—Ä–∞—Ç–∏—á–Ω—ã–º–Ω–µ–¥–µ—Ä–∂–∞–Ω—Å–∫–∏–π–Ω–µ–¥–µ—Ä–∂–∞–Ω—Å–∫–æ–≥–æ&–Ω–µ–¥–µ—Ç–µ—Ä–º–∏–Ω–∏—Ä–æ–≤–∞–Ω–Ω–æ–π–Ω–µ–¥–µ—à–µ–≤–∞—è–Ω–µ–¥–µ—à–µ–≤—ã–µ–Ω–µ–¥–µ—à—ë–≤–æ–π(–Ω–µ–¥–∏—Å—Ü–∏–ø–ª–∏–Ω–∏—Ä–æ–≤–∞–Ω–Ω–æ–µ*–Ω–µ–¥–∏—Å—Ü–∏–ø–ª–∏–Ω–∏—Ä–æ–≤–∞–Ω–Ω—ã–º–∏(–Ω–µ–¥–∏—Ñ—Ñ–µ—Ä–µ–Ω—Ü–∏—Ä–æ–≤–∞–Ω–Ω—ã–º–Ω–µ–¥–æ–±–∏—Ç—ã—Ö–Ω–µ–¥–æ–±—Ä–∞–Ω–Ω—É—é–Ω–µ–¥–æ–±—Ä–æ–¥–µ—Ç–µ–ª–µ–π–Ω–µ–¥–æ–±—Ä–æ–¥–µ—Ç–µ–ª—å&–Ω–µ–¥–æ–±—Ä–æ–∂–µ–ª–∞—Ç–µ–ª—å–Ω–æ–≥–æ$–Ω–µ–¥–æ–±—Ä–æ–∂–µ–ª–∞—Ç–µ–ª—å–Ω–æ–µ$–Ω–µ–¥–æ–±—Ä–æ–∂–µ–ª–∞—Ç–µ–ª—å–Ω–æ–π*–Ω–µ–¥–æ–±—Ä–æ–∂–µ–ª–∞—Ç–µ–ª—å–Ω–æ—Å—Ç—å—é$–Ω–µ–¥–æ–±—Ä–æ–∂–µ–ª–∞—Ç–µ–ª—å–Ω—ã–µ–Ω–µ–¥–æ–±—Ä–æ–∂–µ–ª–∞—Ç–µ–ª—è&–Ω–µ–¥–æ–±—Ä–æ–∫–∞—á–µ—Å—Ç–≤–µ–Ω–Ω–æ–π –Ω–µ–¥–æ–±—Ä–æ—Å–æ–≤–µ—Å—Ç–Ω–∞—è –Ω–µ–¥–æ–±—Ä–æ—Å–æ–≤–µ—Å—Ç–Ω–æ–º –Ω–µ–¥–æ–±—Ä–æ—Å–æ–≤–µ—Å—Ç–Ω—É—é–Ω–µ–¥–æ–≤–≥–æ–Ω–µ–¥–æ–≤–µ—Ä—á–∏–≤–∞—è–Ω–µ–¥–æ–≤–µ—Ä—á–∏–≤–æ–π–Ω–µ–¥–æ–≥–∞–¥–ª–∏–≤–∞—è–Ω–µ–¥–æ–≥–æ–≤–∞—Ä–∏–≤–∞–ª –Ω–µ–¥–æ–≥–æ–≤–æ—Ä–µ–Ω–Ω–æ—Å—Ç–∏–Ω–µ–¥–æ–≥–æ–≤–æ—Ä–∫–∏ –Ω–µ–¥–æ–≥–æ–≤–æ—Ä—ë–Ω–Ω–æ—Å—Ç—å–Ω–µ–¥–æ–≥–æ—Ä–µ–≤—à–∏–µ–Ω–µ–¥–æ–¥–∞–ª–∏–Ω–µ–¥–æ–¥–µ–ª–∞–Ω–Ω–æ–≥–æ–Ω–µ–¥–æ–¥–µ—Ä–∂–∞–Ω–Ω—ã–µ–Ω–µ–¥–æ–µ–¥–µ–Ω–Ω–æ–µ–Ω–µ–¥–æ–µ–¥–µ–Ω–Ω–æ–π–Ω–µ–¥–æ–µ–¥–µ–Ω–Ω—ã–º–Ω–µ–¥–æ–∂–¥—É—Å—å–Ω–µ–¥–æ–∑–≤–æ–ª–µ–Ω–Ω–æ–≥–æ–Ω–µ–¥–æ–∑—Ä–µ–ª—ã–º–Ω–µ–¥–æ–∫–∞–∑–∞–Ω–Ω–æ—Å—Ç—å—é–Ω–µ–¥–æ–∫–∞–∑–∞–Ω–Ω—ã–º–∏–Ω–µ–¥–æ–∫–∞–∑—É–µ–º—ã—Ö&–Ω–µ–¥–æ–∫—É–º–µ–Ω—Ç–∏—Ä–æ–≤–∞–Ω–Ω–∞—è(–Ω–µ–¥–æ–∫—É–º–µ–Ω—Ç–∏—Ä–æ–≤–∞–Ω–Ω—ã–º–∏–Ω–µ–¥–æ–∫—É—Ä–µ–Ω–Ω–∞—è–Ω–µ–¥–æ–ª–≥–æ–≤–µ—á–µ–Ω–Ω–µ–¥–æ–ª–≥–æ–≤–µ—á–Ω–æ–µ–Ω–µ–¥–æ–ª–≥–æ–≤–µ—á–Ω–æ–º–Ω–µ–¥–æ–ª–≥–æ–≤–µ—á–Ω—ã—Ö–Ω–µ–¥–æ–ª–∂–Ω–æ–Ω–µ–¥–æ–ª–∏–Ω–µ–¥–æ–ª—é–±–ª–∏–≤–∞–µ–º–Ω–µ–¥–æ–ª—ë—Ç–Ω–µ–¥–æ–º–æ–≥–∞–Ω–∏—è–º–∏–Ω–µ–¥–æ–º–æ–≥–∞–Ω–∏—è—Ö–Ω–µ–¥–æ–º—ã—Å–ª–∏–µ–º–Ω–µ–¥–æ–Ω–æ—Å–∫–∏–Ω–µ–¥–æ–Ω–æ—à–µ–Ω–Ω–æ–≥–æ–Ω–µ–¥–æ–æ–∫–∏—Å–ª–µ–Ω–Ω—ã–µ–Ω–µ–¥–æ–æ—Ü–µ–Ω–∏–≤–∞–π–Ω–µ–¥–æ–æ—Ü–µ–Ω–∏–≤–∞–ª–∞–Ω–µ–¥–æ–æ—Ü–µ–Ω–∏–≤–∞–ª–∏—Å—å–Ω–µ–¥–æ–æ—Ü–µ–Ω–∏–≤–∞—è–Ω–µ–¥–æ–æ—Ü–µ–Ω–∫–æ–π–Ω–µ–¥–æ–æ—Ü–µ–Ω—ë–Ω–Ω—É—é–Ω–µ–¥–æ–ø–∏—Å–∞–Ω–Ω—ã—Ö–Ω–µ–¥–æ–ø–æ–ª—É—á–∞–µ—Ç–Ω–µ–¥–æ–ø—É—Å—Ç–∏–º–æ—Å—Ç—å—é–Ω–µ–¥–æ–ø—É—â–µ–Ω–∏–µ–º–Ω–µ–¥–æ—Ä–∞–±–æ—Ç–∞–Ω–Ω—ã–º–Ω–µ–¥–æ—Ä–∞–∑–≤–∏—Ç–∏–µ–Ω–µ–¥–æ—Ä–∞–∑–≤–∏—Ç–∏—è–Ω–µ–¥–æ—Ä–∞–∑–≤–∏—Ç—ã–Ω–µ–¥–æ—Ä–∞–∑–≤–∏—Ç—ã–º–∏–Ω–µ–¥–æ—Ä–æ—Å–ª–µ–º–Ω–µ–¥–æ—Ä–æ—Å–ª—è–º–Ω–µ–¥–æ—Ä—É–±–æ–≤ –Ω–µ–¥–æ—Å–∫–∞–∑–∞–Ω–Ω–æ—Å—Ç—å—é–Ω–µ–¥–æ—Å–∫–∞–∑–∞–Ω–Ω—ã–º–Ω–µ–¥–æ—Å–º–æ—Ç—Ä–µ–ª–∏–Ω–µ–¥–æ—Å—Ç–∞–≤–∞—Ç—å–Ω–µ–¥–æ—Å—Ç–∞–≤–∫–µ–Ω–µ–¥–æ—Å—Ç–∞—á–µ–π–Ω–µ–¥–æ—Å—Ç–∏–∂–µ–Ω–∏—è–Ω–µ–¥–æ—Å—Ç–æ–≤–µ—Ä–Ω–∞–Ω–µ–¥–æ—Å—Ç–æ–≤–µ—Ä–Ω—É—é–Ω–µ–¥–æ—Å—Ç–æ–π–Ω–æ—Å—Ç–∏–Ω–µ–¥–æ—Å—Ç–æ–π–Ω–æ—Å—Ç—å–Ω–µ–¥–æ—Å—Ç—Ä–æ–µ–Ω–Ω–æ–µ–Ω–µ–¥–æ—Å—Ç—Ä–æ–µ–Ω–Ω–æ–º—É–Ω–µ–¥–æ—Å—É–≥–æ–º–Ω–µ–¥–æ—Å—è–≥–∞–µ–º–æ–≥–æ–Ω–µ–¥–æ—Å—è–≥–∞–µ–º–æ–º–Ω–µ–¥–æ—Å—è–≥–∞–µ–º–æ—Å—Ç—å–Ω–µ–¥–æ—Ç—ë–ø—É–Ω–µ–¥–æ—É–º–µ–≤–∞—é—â–∏–º–Ω–µ–¥–æ—É–º–µ–Ω–∏–π–Ω–µ–¥–æ—É–º–µ–Ω–Ω—ã–º–∏–Ω–µ–¥–æ—É–º–∫–æ–º–Ω–µ–¥–æ—É—á–∏–≤—à–∏–π—Å—è–Ω–µ–¥–æ—É—á–∫–∞–º–Ω–µ–¥–æ—É—á–∫–∏"–Ω–µ–¥–æ—Ñ–∏–Ω–∞–Ω—Å–∏—Ä–æ–≤–∞–Ω—ã–Ω–µ–¥–æ—á–µ–ª–æ–≤–µ–∫–∞–Ω–µ–¥–æ—á–µ–ª–æ–≤–µ–∫–æ–≤–Ω–µ–¥–æ—á–µ—Ç–Ω–µ–¥–æ—á—ë—Ç–æ–≤–Ω–µ–¥—Ä–∞–º–Ω–µ–¥—Ä–µ–º–ª—é—â–∏–π –Ω–µ–¥—Ä–æ–ø–æ–ª—å–∑–æ–≤–∞–Ω–∏–µ$–Ω–µ–¥—Ä–æ–ø–æ–ª—å–∑–æ–≤–∞—Ç–µ–ª–µ–π"–Ω–µ–¥—Ä–æ–ø–æ–ª—å–∑–æ–≤–∞—Ç–µ–ª–∏–Ω–µ–¥—Ä—É–≥–µ–Ω–µ–¥—Ä—É–≥–æ–º–Ω–µ–¥—Ä—É–∂–µ–ª—é–±–Ω—ã—Ö –Ω–µ–¥—Ä—É–∂–µ—Å—Ç–≤–µ–Ω–Ω–æ–≥–æ–Ω–µ–¥—Ä—É–∂–µ—Å—Ç–≤–µ–Ω–Ω–æ–π –Ω–µ–¥—Ä—É–∂–µ—Å—Ç–≤–µ–Ω–Ω—ã–º–∏–Ω–µ–¥—Ä—É–∂–µ—Å—Ç–≤–µ–Ω–Ω—ã—Ö–Ω–µ–¥—É–≥–∞–º–Ω–µ–¥—É–≥–∞—Ö–Ω–µ–¥—É–∂–Ω—ã—è–Ω–µ–¥—É—Ä–Ω—ã–µ–Ω–µ–µ–≤–∫–ª–∏–¥–æ–≤—É–Ω–µ–µ–≤–∫–ª–∏–¥–æ–≤—ã–º–∏–Ω–µ–µ–≤—Ä–µ–π—Å–∫–æ–µ–Ω–µ–µ–≤—Ä–æ–ø–µ–π—Å–∫–æ–≥–æ
–Ω–µ–µ–ª–∏–Ω–µ–µ—Å—Ç–µ—Å—Ç–≤–µ–Ω–Ω—ã–Ω–µ–∂–∞—Ä—Ç–æ–Ω–∞–Ω–µ–∂–∞—Å—å–Ω–µ–∂–∞—Ç–∏–Ω–æ–π–Ω–µ–∂–∞—Ç—Å—è–Ω–µ–∂–¥–∞–Ω–Ω—ã–º–∏–Ω–µ–∂–µ–ª–∞–Ω–Ω–æ–≥–æ–Ω–µ–∂–µ–ª–∞–Ω–Ω–æ–º—É–Ω–µ–∂–µ–ª–∞–Ω–Ω—ã–º–Ω–µ–∂–µ–ª–∞—Ç–µ–ª—å–Ω–æ–º–Ω–µ–∂–µ–ª–∞—Ç–µ–ª—å–Ω–æ—Å—Ç—å –Ω–µ–∂–∏–∑–Ω–µ—Å–ø–æ—Å–æ–±–Ω–∞—è$–Ω–µ–∂–∏–∑–Ω–µ—Å–ø–æ—Å–æ–±–Ω–æ—Å—Ç–∏$–Ω–µ–∂–∏–∑–Ω–µ—Å–ø–æ—Å–æ–±–Ω–æ—Å—Ç—å –Ω–µ–∂–∏–∑–Ω–µ—Å–ø–æ—Å–æ–±–Ω—ã–µ –Ω–µ–∂–∏–∑–Ω–µ—Å–ø–æ—Å–æ–±–Ω—ã–π–Ω–µ–∂–∏–ª—ã–º–Ω–µ–∂–∏–Ω–∞–Ω–µ–∂–Ω–µ–π—à–µ–π–Ω–µ–∑–Ω–µ–∑–∞–±–≤–µ–Ω–Ω—ã–µ–Ω–µ–∑–∞–±–≤–µ–Ω–Ω—ã–º–Ω–µ–∑–∞–±—É–¥–∫–µ–Ω–µ–∑–∞–±—ã–≤–∞–µ–º–Ω–µ–∑–∞–±—ã–≤–∞–µ–º—ã–Ω–µ–∑–∞–≤–µ—Ä—à–µ–Ω–Ω—ã—Ö–Ω–µ–∑–∞–≤–µ—Ä—à—ë–Ω–Ω–∞—è–Ω–µ–∑–∞–≤–µ—Ä—à—ë–Ω–Ω–æ—Å—Ç–∏–Ω–µ–∑–∞–≤–∏–Ω–µ–∑–∞–≤–∏–¥–Ω–æ–º–Ω–µ–∑–∞–≤–∏—Å—è—â–∏—Ö–Ω–µ–∑–∞–¥–∞—á–ª–∏–≤–æ–µ–Ω–µ–∑–∞–¥–∞—á–ª–∏–≤–æ–π–Ω–µ–∑–∞–¥–∞—á–ª–∏–≤–æ–º—É–Ω–µ–∑–∞–¥–∞—á–ª–∏–≤—ã–µ&–Ω–µ–∑–∞–∏–Ω—Ç–µ—Ä–µ—Å–æ–≤–∞–Ω–Ω–æ–≥–æ(–Ω–µ–∑–∞–∏–Ω—Ç–µ—Ä–µ—Å–æ–≤–∞–Ω–Ω–æ—Å—Ç–∏(–Ω–µ–∑–∞–∏–Ω—Ç–µ—Ä–µ—Å–æ–≤–∞–Ω–Ω–æ—Å—Ç—å$–Ω–µ–∑–∞–∏–Ω—Ç–µ—Ä–µ—Å–æ–≤–∞–Ω–Ω—ã–µ$–Ω–µ–∑–∞–∏–Ω—Ç–µ—Ä–µ—Å–æ–≤–∞–Ω–Ω—ã–π$–Ω–µ–∑–∞–∏–Ω—Ç–µ—Ä–µ—Å–æ–≤–∞–Ω–Ω—ã—Ö$–Ω–µ–∑–∞–∫–æ–Ω–Ω–æ—Ä–æ–∂–¥–µ–Ω–Ω–∞—è–Ω–µ–∑–∞–∫–æ–Ω—á–µ–Ω–Ω–æ–º–Ω–µ–∑–∞–ª–µ–∂–Ω–æ–≥–æ–Ω–µ–∑–∞–ª–µ–∂–Ω–æ—Å—Ç–Ω–µ–∑–∞–ª–µ–∂–Ω—Å—Ç—å–Ω–µ–∑–∞–ª—ç–∂–Ω–æ–π–Ω–µ–∑–∞–ª—ç–∂–Ω–æ—Å—Ç–∏"–Ω–µ–∑–∞–º–µ–¥–ª–∏—Ç–µ–ª—å–Ω–æ–º—É–Ω–µ–∑–∞–º–µ–Ω–∏–º–æ—Å—Ç–∏–Ω–µ–∑–∞–º–µ—Ä–∑–∞—é—â–∏–µ–Ω–µ–∑–∞–º–µ—Ç–Ω–æ–º—É–Ω–µ–∑–∞–º–µ—Ç–Ω–æ—Å—Ç—å–Ω–µ–∑–∞–º—É—Ç–Ω–µ–Ω–Ω–æ–π–Ω–µ–∑–∞–º—É—Ç–Ω–µ–Ω–Ω—ã–π–Ω–µ–∑–∞–º—ã—Å–ª–æ–≤–∞—Ç–Ω–µ–∑–∞–º—ã—Å–ª–æ–≤–∞—Ç–æ–≥–æ–Ω–µ–∑–∞–º—ã—Å–ª–æ–≤–∞—Ç—É—é–Ω–µ–∑–∞–Ω—è—Ç–æ–≥–æ–Ω–µ–∑–∞–Ω—è—Ç–æ–µ–Ω–µ–∑–∞–Ω—è—Ç–æ—Å—Ç–∏–Ω–µ–∑–∞–Ω—è—Ç—É—é–Ω–µ–∑–∞–Ω—è—Ç—ã–º–∏–Ω–µ–∑–∞–ø–∞–¥–Ω—ã–º–Ω–µ–∑–∞–ø–µ—Ä—Ç—ã–º–∏"–Ω–µ–∑–∞–ø–ª–∞–Ω–∏—Ä–æ–≤–∞–Ω–Ω—ã–º$–Ω–µ–∑–∞–ø–ª–∞–Ω–∏—Ä–æ–≤–∞–Ω–Ω—ã–º–∏–Ω–µ–∑–∞–ø–æ–ª–Ω–µ–Ω–Ω–æ–π–Ω–µ–∑–∞–ø–æ–ª–Ω–µ–Ω–Ω—ã–µ–Ω–µ–∑–∞–ø—è—Ç–Ω–∞–Ω–Ω–∞—è–Ω–µ–∑–∞–ø—è—Ç–Ω–∞–Ω–Ω—ã–µ–Ω–µ–∑–∞–ø—è—Ç–Ω–∞–Ω–Ω—ã–º–∏*–Ω–µ–∑–∞—Ä–µ–≥–∏—Å—Ç—Ä–∏—Ä–æ–≤–∞–Ω–Ω–æ–≥–æ–Ω–µ–∑–∞—Ä—è–∂–µ–Ω–Ω–∞—è–Ω–µ–∑–∞—Ä—è–∂–µ–Ω–Ω—ã–π–Ω–µ–∑–∞—Ä—è–∂–µ–Ω–Ω—ã–º–Ω–µ–∑–∞—Å–µ–ª—ë–Ω–Ω—ã–º–Ω–µ–∑–∞—Å–ª—É–∂–µ–Ω–Ω—É—é–Ω–µ–∑–∞—Å–ª—É–∂–µ–Ω–Ω—ã–π –Ω–µ–∑–∞—Å—Ç—Ä–∞—Ö–æ–≤–∞–Ω–Ω—ã–µ–Ω–µ–∑–∞—Ç–µ–π–ª–∏–≤–æ–º—É–Ω–µ–∑–∞—Ç–µ–π–ª–∏–≤—ã—Ö–Ω–µ–∑–∞—Ç—É—Ö–∞—é—â–µ–≥–æ–Ω–µ–∑–∞—Ç—É—Ö–∞—é—â–∏–π–Ω–µ–∑–∞—Ç—É—Ö–∞—é—â–∏—Ö–Ω–µ–∑–∞—É—Ä—è–¥–Ω–æ–Ω–µ–∑–∞—É—Ä—è–¥–Ω–æ—Å—Ç—å—é–Ω–µ–∑–∞—É—Ä—è–¥–Ω—ã—Ö"–Ω–µ–∑–∞—Ñ–∏–∫—Å–∏—Ä–æ–≤–∞–Ω–Ω—ã—Ö–Ω–µ–∑–∞—á–µ—Ä–∫–Ω—É—Ç–æ–µ–Ω–µ–∑–∞—á–µ—Ç–Ω–µ–∑–∞—á—Ç–æ–Ω–µ–∑–∞—à–∏—Ñ—Ä–æ–≤–∞–Ω–Ω—ã–µ–Ω–µ–∑–∞—â–∏—â–µ–Ω–Ω–æ–µ–Ω–µ–∑–∞—â–∏—â—ë–Ω–Ω—ã–µ–Ω–µ–∑–≤–∞–Ω–Ω—ã–µ–Ω–µ–∑–≤–∞–Ω–Ω—ã–π–Ω–µ–∑–≤–∞–Ω–æ–π–Ω–µ–∑–¥–∏–π–º–∏–Ω–æ–≥–∞–Ω–µ–∑–µ–º–Ω—ã–º–∏
–Ω–µ–∑–ª–æ–Ω–µ–∑–ª–æ–±–∏–≤–Ω–µ–∑–ª–æ–±–∏–≤–æ–Ω–µ–∑–Ω–∞—Ç–Ω—ã–µ–Ω–µ–∑–Ω–∞—Ç–Ω—ã—Ö–Ω–µ–∑–Ω–∞—é—â–∏–µ–Ω–µ–∑–Ω–∞—é—â–∏—Ö–Ω–µ–∑—Ä–µ–ª—ã–º–∏–Ω–µ–∑—ã–±–ª–µ–º–Ω–µ–∏–≥—Ä–æ–≤–æ–π(–Ω–µ–∏–¥–µ–Ω—Ç–∏—Ñ–∏—Ü–∏—Ä–æ–≤–∞–Ω–Ω—ã—Ö–Ω–µ–∏–∑–Ω–µ–∏–∑–±–∏—Ä–∞–µ–º—ã–π–Ω–µ–∏–∑–±–∏—Ä–∞–µ–º—ã–º–Ω–µ–∏–∑–≥–ª–∞–¥–∏–º—ã–º–Ω–µ–∏–∑–¥–∞–Ω–Ω–æ–π–Ω–µ–∏–∑–¥–∞–Ω–Ω—ã–π–Ω–µ–∏–∑–ª–µ—á–∏–º—ã–µ–Ω–µ–∏–∑–º–µ–Ω–µ–Ω–Ω–æ–π–Ω–µ–∏–∑–º–µ–Ω–Ω–æ—Å—Ç—å—é–Ω–µ–∏–∑–º–µ–Ω—è–µ–º–æ–µ–Ω–µ–∏–∑–º–µ–Ω—è–µ–º–æ—Å—Ç–∏–Ω–µ–∏–∑–º–µ–Ω—è–µ–º–æ—Å—Ç—å–Ω–µ–∏–∑–º–µ—Ä–∏–º—É—é–Ω–µ–∏–∑–º–µ—Ä–∏–º—ã—Ö"–Ω–µ–∏–∑–æ–±—Ä–∞–∑–∏—Ç–µ–ª—å–Ω—ã–º–Ω–µ–∏–∑—Ä–µ—á–µ–Ω–Ω–∞—è–Ω–µ–∏–∑—Ä–µ—á–µ–Ω–Ω–æ–≥–æ–Ω–µ–∏–∑—Ä–µ—á–µ–Ω–Ω—ã—Ö–Ω–µ–∏–∑—É—á–µ–Ω–Ω—ã–º–∏–Ω–µ–∏–∑—ä—è—Å–Ω–∏–º—ã–π–Ω–µ–∏–º–æ–≤–µ—Ä–Ω–æ–º—É–Ω–µ–∏–º—É—â–µ–º—É–Ω–µ–∏–Ω–≤–∞–∑–∏–≤–Ω—ã–µ–Ω–µ–∏–Ω–≤–∞–∑–∏–≤–Ω—ã–π–Ω–µ–∏–Ω–≥–∞–ª—è—Ü–∏–æ–Ω–Ω—ã–µ"–Ω–µ–∏–Ω–¥–æ–µ–≤—Ä–æ–ø–µ–π—Å–∫–∏—Ö(–Ω–µ–∏–Ω–∏—Ü–∏–∞–ª–∏–∑–∏—Ä–æ–≤–∞–Ω–Ω—ã—Ö –Ω–µ–∏—Å–∫–ª—é—á–∏—Ç–µ–ª—å–Ω—ã–µ–Ω–µ–∏—Å–∫–æ–ø–∞–µ–º–æ–≥–æ–Ω–µ–∏—Å–∫—Ä–µ–Ω–µ–Ω–Ω–µ–∏—Å–∫—Ä–µ–Ω–Ω–µ–µ–Ω–µ–∏—Å–∫—Ä–µ–Ω–Ω–∏–º–∏–Ω–µ–∏—Å–∫—É—à—ë–Ω–Ω–æ–≥–æ–Ω–µ–∏—Å–∫—É—à—ë–Ω–Ω—ã–π–Ω–µ–∏—Å–∫—É—à—ë–Ω–Ω—ã—Ö–Ω–µ–∏—Å–ª–∞–º—Å–∫–∏–º–Ω–µ–∏—Å–ø–æ–≤–µ–¥–∏–º—ã–º–Ω–µ–∏—Å–ø–æ–ª–Ω–µ–Ω–∏–∏–Ω–µ–∏—Å–ø–æ–ª–Ω–∏–º—ã–µ–Ω–µ–∏—Å–ø–æ–ª—å–∑–æ–≤–∞–Ω–∏–µ"–Ω–µ–∏—Å–ø–æ–ª—å–∑–æ–≤–∞–Ω–Ω–æ–≥–æ –Ω–µ–∏—Å–ø–æ–ª—å–∑–æ–≤–∞–Ω–Ω—ã–º–Ω–µ–∏—Å–ø–æ–ª—å–∑—É–µ–º–æ–µ–Ω–µ–∏—Å–ø–æ–ª—å–∑—É–µ–º–æ–º—É–Ω–µ–∏—Å–ø–æ–ª—å–∑—É–µ–º—ã–º–∏–Ω–µ–∏—Å–ø–æ—Ä—á–µ–Ω–Ω–æ–Ω–µ–∏—Å–ø–æ—Ä—á–µ–Ω–Ω—ã–µ–Ω–µ–∏—Å–ø—Ä–∞–≤–∏–º–æ–π–Ω–µ–∏—Å–ø—Ä–∞–≤–Ω–æ–µ–Ω–µ–∏—Å–ø—Ä–∞–≤–Ω—ã–µ–Ω–µ–∏—Å—Å—è–∫–∞–µ–º–∞—è–Ω–µ–∏—Å—Å—è–∫–∞–µ–º–æ–º–Ω–µ–∏—Å—Ç–æ–≤–Ω–µ–∏—Å—Ç–æ–≤–æ–º—É–Ω–µ–∏—Å—Ç–æ–≤—Å—Ç–≤–æ–≤–∞—Ç—å–Ω–µ–∏—Å—Ç–æ–≤—Å—Ç–≤—É–µ—Ç–Ω–µ–∏—Å—Ç–æ–≤—É—é–Ω–µ–∏—Å—Ç–æ—â–∏–º–æ–π–Ω–µ–∏—Å—Ç—Ä–µ–±–∏–º–Ω–µ–∏—Å—Ç—Ä–µ–±–∏–º–æ–Ω–µ–∏—Å—Ç—Ä–µ–±–∏–º–æ–≥–æ–Ω–µ–∏—Å—Ç—Ä–µ–±–∏–º–æ–π–Ω–µ–∏—Å—Ç—Ä–µ–±–∏–º—ã–π–Ω–µ–∏—Å—á–µ—Ä–ø–∞–µ–º–æ–º—É–Ω–µ–∏—Å—á–µ—Ä–ø–∞–µ–º—ã—Ö–Ω–µ–∏—Å—á–∏—Å–ª–∏–º–æ–º—É
–Ω–µ–π–≤–µ
–Ω–µ–π–≤–∏–Ω–µ–π–≥–µ–±–∞—É—ç—Ä–Ω–µ–π–¥–µ—Ç–Ω–µ–π–ª–æ–º–Ω–µ–π–º–∞—Ä–Ω–µ–π–ø–∏—Ä–Ω–µ–π–ø–∏—Ä–∞"–Ω–µ–π—Ä–æ–≤–∏–∑—É–∞–ª–∏–∑–∞—Ü–∏–∏–Ω–µ–π—Ä–æ–≥–µ–Ω–µ–∑–Ω–µ–π—Ä–æ–≥–∏–ø–æ—Ñ–∏–∑–Ω–µ–π—Ä–æ–≥–æ—Ä–º–æ–Ω—ã–Ω–µ–π—Ä–æ–ª–µ–ø—Ç–∏–∫–∞–º–Ω–µ–π—Ä–æ–ª–µ–ø—Ç–∏–∫–æ–º"–Ω–µ–π—Ä–æ–ª–µ–ø—Ç–∏—á–µ—Å–∫–æ–º—É –Ω–µ–π—Ä–æ–º–µ–¥–∏–∞—Ç–æ—Ä–∞–º–∏ –Ω–µ–π—Ä–æ–º–µ–¥–∏–∞—Ç–æ—Ä–Ω—ã–µ–Ω–µ–π—Ä–æ–Ω–µ"–Ω–µ–π—Ä–æ—Ä–∞–∑–Ω–æ–æ–±—Ä–∞–∑–∏–µ–Ω–µ–π—Ä–æ—Ç–æ–∫—Å–∏–Ω –Ω–µ–π—Ä–æ—Ç–æ–∫—Å–∏—á–µ—Å–∫–∏–µ"–Ω–µ–π—Ä–æ—Ç–æ–∫—Å–∏—á–µ—Å–∫–∏–º–∏ –Ω–µ–π—Ä–æ—Ç—Ä–∞–Ω—Å–º–∏—Ç—Ç–µ—Ä"–Ω–µ–π—Ä–æ—Ç—Ä–∞–Ω—Å–º–∏—Ç—Ç–µ—Ä—ã–Ω–µ–π—Ä–æ—Ñ–∏–∑–∏–æ–ª–æ–≥–∞–Ω–µ–π—Ä–æ—Ñ–∏–ª–∞–º–µ–Ω—Ç—ã–Ω–µ–π—Ä–æ—Ö–∏–º–∏—á–µ—Å–∫–∏–µ–Ω–µ–π—Ä–æ—Ö–∏–º–∏—á–µ—Å–∫–æ–º$–Ω–µ–π—Ä–æ—Ö–∏—Ä—É—Ä–≥–∏—á–µ—Å–∫–æ–µ–Ω–µ–π—Ä–æ—Ö–∏—Ä—É—Ä–≥–æ–º–Ω–µ–π—Ä–æ—Ü–∏—Ç–æ–≤–Ω–µ–π—Ä–æ—à–ª–µ–º$–Ω–µ–π—Ä–æ—ç–ø–∏—Ç–µ–ª–∏–∞–ª—å–Ω—ã—Ö–Ω–µ–π—Ç—Ä–∞–Ω–µ–π—Ç—Ä–∞–ª–∏–∑–∞—Ç–æ—Ä–∞–Ω–µ–π—Ç—Ä–∞–ª–∏–∑–∞—Ü–∏—é–Ω–µ–π—Ç—Ä–∞–ª–∏–∑–º–∞–Ω–µ–π—Ç—Ä–∞–ª–∏–∑–æ–≤–∞–≤ –Ω–µ–π—Ç—Ä–∞–ª–∏–∑–æ–≤–∞–Ω–Ω–∞—è–Ω–µ–π—Ç—Ä–∞–ª–∏–∑–æ–≤–∞–Ω–æ–Ω–µ–π—Ç—Ä–∞–ª–∏–∑—É–µ–º–Ω–µ–π—Ç—Ä–∞–ª–∏–∑—É—è–Ω–µ–π—Ç—Ä–∏–Ω–Ω–æ–µ–Ω–µ–π—Ç—Ä–æ–Ω–∏–∑–∞—Ü–∏—è–Ω–µ–π—Ç—Ä–æ–Ω–Ω—ã–º$–Ω–µ–π—Ç—Ä–æ–Ω–æ–¥–µ—Ñ–∏—Ü–∏—Ç–Ω—ã–µ–Ω–µ–π—Ç—Ä–æ—Ñ–∏–ª—ã–Ω–µ–π—Ç—Ä–æ—Ñ–∏–ª—å–Ω—ã–π–Ω–µ–π—à—Ç–∞–¥—Ç–Ω–µ–∫–∞–Ω–µ–∫–∞–∑–∏—Å—Ç—ã–º–Ω–µ–∫–∞—Ç–æ–ª–∏—á–µ—Å–∫–∏—Ö(–Ω–µ–∫–≤–∞–ª–∏—Ñ–∏—Ü–∏—Ä–æ–≤–∞–Ω–Ω—ã–º–∏–Ω–µ–∫–∏—Ç–∞–π—Å–∫–∏–µ–Ω–µ–∫–ª—é–¥–æ–≤–∞–Ω–µ–∫–æ–≤–∞–ª–µ–Ω—Ç–Ω—ã–º–∏–Ω–µ–∫–æ–¥–∏—Ä—É—é—â–∞—è–Ω–µ–∫–æ–ª–µ–±–∏–º—É—é–Ω–µ–∫–æ–º–±–∞—Ç–∞–Ω—Ç–æ–≤$–Ω–µ–∫–æ–º–º—É–Ω–∏—Å—Ç–∏—á–µ—Å–∫–∏–º"–Ω–µ–∫–æ–º–º—É—Ç–∞—Ç–∏–≤–Ω–æ—Å—Ç—å–Ω–µ–∫–æ–Ω–¥–∏—Ü–∏–æ–Ω–Ω—ã–π–Ω–µ–∫–æ–Ω–∫—É—Ä–µ–Ω—Ç–Ω—ã–µ(–Ω–µ–∫–æ–Ω–∫—É—Ä–µ–Ω—Ç–æ—Å–ø–æ—Å–æ–±–Ω–∞.–Ω–µ–∫–æ–Ω–∫—É—Ä–µ–Ω—Ç–æ—Å–ø–æ—Å–æ–±–Ω–æ—Å—Ç–∏*–Ω–µ–∫–æ–Ω–∫—É—Ä–µ–Ω—Ç–æ—Å–ø–æ—Å–æ–±–Ω—ã–π"–Ω–µ–∫–æ–Ω—Å—Ç–∏—Ç—É—Ü–∏–æ–Ω–Ω—ã–µ –Ω–µ–∫–æ–Ω—ä—é–Ω–∫—Ç—É—Ä–Ω–æ–≥–æ–Ω–µ–∫–æ—Ä–µ–Ω–Ω–æ–≥–æ–Ω–µ–∫–æ—Ä—Ä–µ–∫—Ç–Ω–æ–º—É–Ω–µ–∫–æ—Ä—Ä–µ–∫—Ç–Ω—É—é&–Ω–µ–∫–æ—Ä—Ä—É–º–ø–∏—Ä–æ–≤–∞–Ω–Ω–æ–≥–æ–Ω–µ–∫—Ä–∞—Å–∏–≤–µ–µ–Ω–µ–∫—Ä–∞—Å–æ–≤—Å–∫–∏–µ–Ω–µ–∫—Ä–µ–ø–∫–æ–Ω–µ–∫—Ä–µ—â—ë–Ω—ã