–∑–∞–∫—É—é–∑–∞–ª–∞–¥–∏–ª–∞—Å—å–∑–∞–ª–∞–¥–∏–ª—Å—è–∑–∞–ª–∞–∑–∏—Ç–∑–∞–ª–∞–∑–∏—Ç—å–∑–∞–ª–∞–∑—å—Ç–µ–∑–∞–ª–∞–º—ã–≤–∞–Ω–∏–µ–∑–∞–ª–µ–≥–∞–Ω–∏–∏–∑–∞–ª–µ–¥–µ–Ω–µ–ª–∑–∞–ª–µ–¥–µ–Ω–µ–ª–∞–∑–∞–ª–µ–¥–µ–Ω–µ–ª–∏–∑–∞–ª–µ–∑–∞–µ—à—å–∑–∞–ª–µ–∑–ª–æ–∑–∞–ª–µ–ø–µ—Ç–∞–ª–∞–∑–∞–ª–µ–ø–ª—é–∑–∞–ª–µ—Å–∫–∏–∑–∞–ª–µ—Å–æ–≤—Å–∫–∏–π–∑–∞–ª–µ—Ç–ª–∞–∑–∞–ª–µ—Ç–Ω—ã–π–∑–∞–ª–µ—á–∏–≤–∞—Ç—å–∑–∞–ª–µ—á–∏–≤–∞—è–∑–∞–ª–µ—á—É–∑–∞–ª–∏–≤–∞–µ—Ç–µ–∑–∞–ª–∏–≤–∞–µ—à—å—Å—è–∑–∞–ª–∏–≤–∞—é—Å—å–∑–∞–ª–∏–≤–∏–Ω–æ–∑–∞–ª–∏–≤–∫–µ–∑–∞–ª–∏–≤–Ω–æ–π–∑–∞–ª–∏–≤–Ω—ã–º–∏–∑–∞–ª–∏–≤–æ—á–Ω—ã–π–∑–∞–ª–∏–ª–æ—Å—å–∑–∞–ª–∏–ø–∞–Ω–∏—è–∑–∞–ª–∏—Ç—ã–º–∑–∞–ª–∏—Ö–≤–∞—Ç—Å–∫–∏–µ–∑–∞–ª–∏—Ö–≤–∞—Ç—Å–∫–æ–µ–∑–∞–ª–∏—à–∏—Ç–∏—Å—è–∑–∞–ª–º–∞–Ω–æ–≤–∏—á–∑–∞–ª–º–∞–Ω–æ–º–∑–∞–ª–ø–æ–≤—ã–π–∑–∞–ª—å—é—Ç–∑–∞–º–∞–∂–µ–º–∑–∞–º–∞–∑–∞–ª–∏–∑–∞–º–∞–ª—á–∏–≤–∞–ª–∏—Å—å–∑–∞–º–∞–ª—á–∏–≤–∞–Ω–∏–∏–∑–∞–º–∞–ª—á–∏–≤–∞–Ω–∏—é–∑–∞–º–∞–ª—á–∏–≤–∞—é—Ç—Å—è–∑–∞–º–∞–ª—á–∏–≤–∞—è–∑–∞–º–∞–Ω—É—Ö–∞–∑–∞–º–∞–Ω—á–∏–≤–∞–∑–∞–º–∞—Ä–∞–Ω—ã–∑–∞–º–∞—Ä–∞—é–∑–∞–º–∞—Å–∫–∏—Ä—É–µ–º–∑–∞–º–∞—Ö–µ–∑–∞–º–∞—Ö–∏–≤–∞–µ—à—å—Å—è–∑–∞–º–∞—Ö–∏–≤–∞–ª–∏—Å—å–∑–∞–º–∞—Ö–∏–≤–∞–ª—Å—è–∑–∞–º–∞—Ö–∏–≤–∞—Ç—å—Å—è–∑–∞–º–∞—à–∫–∞–º–∑–∞–º–∞—è–ª—Å—è–∑–∞–º–±–∏–π—Å–∫–∏–π–∑–∞–º–¥–µ–∫–∞–Ω–∞–∑–∞–º–µ–∑–∞–º–µ–¥–ª–µ–Ω–Ω–æ—Å—Ç—å–∑–∞–º–µ–¥–ª–µ–Ω–Ω—ã—Ö–∑–∞–º–µ–¥–ª–∏—Ç–µ–ª–µ–º–∑–∞–º–µ–¥–ª—è–ª–∑–∞–º–µ–ª—å–∫–∞–ª–∑–∞–º–µ–ª—å–∫–∞–ª–æ–∑–∞–º–µ–Ω–≥–æ—Ñ—É–∑–∞–º–µ–Ω–∏–≤—à–µ–µ–∑–∞–º–µ–Ω–∏–º—ã—Ö–∑–∞–º–µ–Ω–∏—Ç–µ–ª—è–º–∏–∑–∞–º–µ—Ä–∑–∞—é—â–∏—Ö–∑–∞–º–µ—Ä–∑–∞—è–∑–∞–º–µ—Ä–∑–Ω–∏—Ç–µ–∑–∞–º–µ—Ä–∑—à–∏—Ö–∑–∞–º–µ—Ä—Ü–∞–ª–∞–∑–∞–º–µ—Ä—à–∞—è–∑–∞–º–µ—Ä—à–∏–π–∑–∞–º–µ—Ä—è–ª–∏–∑–∞–º–µ—Å–∞–∑–∞–º–µ—Ç–∞–ª–æ—Å—å–∑–∞–º–µ—Ç–∞—Ç—å–∑–∞–º–µ—Ç–∏–≤—à–µ–≥–æ–∑–∞–º–µ—á–∞–π—Ç–µ –∑–∞–º–µ—á–∞—Ç–µ–ª—å–Ω–µ–π—à–∏—Ö–∑–∞–º–µ—á–µ–Ω–Ω–æ–µ–∑–∞–º–µ—á—Ç–∞–≤—à–∏—Å—å–∑–∞–º–µ—à–∞–Ω–Ω–æ–≥–æ–∑–∞–º–µ—à–∫–∞–ª–∏—Å—å–∑–∞–º–µ—â–∞–ª–∏–∑–∞–º–µ—â–∞—é—â–∏–µ–∑–∞–º–µ—â–∞—é—â–∏–π–∑–∞–º–µ—â–µ–Ω–æ–∑–∞–º–µ—â—ë–Ω–Ω—ã–µ–∑–∞–º–∂–∑–∞–º–∏–Ω–∏—Ä–æ–≤–∞–ª–∑–∞–º–∏–Ω–∏—Ä–æ–≤–∞–Ω–Ω—ã–µ–∑–∞–º–∏–Ω–∏—Ä–æ–≤–∞–Ω–Ω—ã—Ö–∑–∞–º–∏–Ω–∫—É–∑–∞–º–∏–Ω–æ–∫–∑–∞–º–∫–Ω—É–≤—à–∏—